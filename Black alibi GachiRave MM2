    local Pill = Instance.new("TextLabel")
    Pill.AnchorPoint = Vector2.new(1, 0.5)
    Pill.Size = UDim2.fromOffset(42, 19)
    Pill.Position = UDim2.new(1, -10, 0.5, 0)
    Pill.BackgroundColor3 = Color3.fromRGB(38, 38, 45)
    Pill.Text = "OFF"
    Pill.TextColor3 = Palette.TextFaint
    Pill.Font = Enum.Font.Code
    Pill.TextSize = 10
    Pill.ZIndex = 5
    Pill.Parent = Row
    Corner(Pill, 10)

    local PS = Instance.new("UIScale")
    PS.Parent = Pill

    local On = false

    local function Render()
        Animate(Row, TweenFast, {BackgroundColor3 = On and Palette.AccentSoft or Color3.fromRGB(27, 27, 32)})
        Animate(RS, TweenFast, {Color = On and Palette.Accent or Palette.Stroke, Transparency = On and 0.35 or 0.4})
        Animate(Label, TweenFast, {TextColor3 = On and Palette.TextMain or Color3.fromRGB(196, 196, 206)})
        Animate(Pill, TweenFast, {BackgroundColor3 = On and Palette.Accent or Color3.fromRGB(38, 38, 45)})
        Pill.Text = On and "ON" or "OFF"
        Pill.TextColor3 = On and Color3.fromRGB(255, 255, 255) or Palette.TextFaint
        PS.Scale = 0.7
        Animate(PS, TweenSpring, {Scale = 1})
    end

    Row.Activated:Connect(function()
        On = not On
        Render()
        OnChange(On)
    end)

    return function(State)
        State = State and true or false
        if State == On then return end
        On = State
        Render()
        OnChange(On)
    end
end

