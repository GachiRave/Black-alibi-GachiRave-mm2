local HitboxOn = false
local HitboxSize = 6
local StopHitbox

do
    local Conn = nil
    local Saved = {}
    local NextSweep = 0

    local function Restore()
        for Root, Data in pairs(Saved) do
            if Root and Root.Parent then
                pcall(function()
                    Root.Size = Data.Size
                    Root.Transparency = Data.Transparency
                    Root.CanCollide = Data.CanCollide
                end)
            end
        end
        table.clear(Saved)
    end

    StopHitbox = function()
        if Conn then
            Conn:Disconnect()
            Conn = nil
        end
        Restore()
    end

    Setters.Hitbox = ToggleRow(PageExtra, "УВЕЛИЧЕНИЕ ХИТБОКСОВ", 106, function(S)
        HitboxOn = S
        if not S then
            StopHitbox()
            return
        end

        Conn = RunService.Heartbeat:Connect(function()
            if not Alive or not HitboxOn then return end
            if os.clock() < NextSweep then return end
            NextSweep = os.clock() + 0.4

            for _, Other in ipairs(PlayersService:GetPlayers()) do
                if Other ~= LocalPlayer then
                    local OC = Other.Character
                    local Root = OC and OC:FindFirstChild("HumanoidRootPart")
                    local OH = OC and OC:FindFirstChildOfClass("Humanoid")

                    if Root and OH and OH.Health > 0 then
                        if Saved[Root] == nil then
                            Saved[Root] = {
                                Size = Root.Size,
                                Transparency = Root.Transparency,
                                CanCollide = Root.CanCollide,
                            }
                        end
                        local Target = Vector3.new(HitboxSize, HitboxSize, HitboxSize)
                        if (Root.Size - Target).Magnitude > 0.1 then
                            pcall(function()
                                Root.Size = Target
                                Root.Transparency = 0.85
                                Root.CanCollide = false
                            end)
                        end
                    end
                end
            end
        end)
    end)

