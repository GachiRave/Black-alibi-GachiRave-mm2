local SherPanel = RolePanel("ШЕРИФ", Palette.Blue, 298, 152)

do
    local Fab = nil
    local NextShot = 0

    local function FindMurderer()
        if not GetRole then return nil end
        for _, Other in ipairs(PlayersService:GetPlayers()) do
            if Other ~= LocalPlayer and GetRole(Other) == "Murderer" then
                local OC = Other.Character
                local Body = OC and BodyPart(OC)
                local OH = OC and OC:FindFirstChildOfClass("Humanoid")
                if Body and OH and OH.Health > 0 then
                    return Other, Body
                end
            end
        end
        return nil
    end

    -- MM2 resolves the shot on the client and hands the server a hit
    -- position through ShootGun. the camera is never read, which is why
    -- every camera based aim missed. we call the remote directly.
    local function ShootRemote(Gun)
        local Direct = Gun:FindFirstChild("ShootGun", true)
        if Direct and (Direct:IsA("RemoteFunction") or Direct:IsA("RemoteEvent")) then
            return Direct
        end
        for _, Item in ipairs(Gun:GetDescendants()) do
            if Item:IsA("RemoteFunction") or Item:IsA("RemoteEvent") then
                return Item
            end
        end
        return nil
    end

    local function FireAt(Gun, Position)
        local Remote = ShootRemote(Gun)
        if not Remote then return false end

        local Sent = false
        if Remote:IsA("RemoteFunction") then
            Sent = pcall(function() Remote:InvokeServer(1, Position, "AH2") end)
            if not Sent then
                Sent = pcall(function() Remote:InvokeServer(Position) end)
            end
        else
            Sent = pcall(function() Remote:FireServer(1, Position, "AH2") end)
            if not Sent then
                Sent = pcall(function() Remote:FireServer(Position) end)
            end
        end
        return Sent
    end

    local function RunShot()
        if os.clock() < NextShot then return end

        local Gun = EquipGun()
        if not Gun then
            Notify("SILENT AIM", "Револьвера нет.", Palette.Blue)
            return
