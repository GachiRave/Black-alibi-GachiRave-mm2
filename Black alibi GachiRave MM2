end

local function HasDecorativeAncestor(GunObject)
    local Current = GunObject.Parent
    while Current and Current ~= workspace do
        local LowerName = string.lower(Current.Name)
        for _, Word in ipairs(DecorativeContainerWords) do
            if string.find(LowerName, Word, 1, true) then
                return true
            end
        end
        Current = Current.Parent
    end
    return false
end

local function IsDroppedGunCandidate(GunObject)
    if not GunObject
        or not GunDropNames[GunObject.Name]
        or not GunObject:IsDescendantOf(workspace) then
        return false
    end

    -- SHERIFF FALSE ALARM FIX.
    -- When you receive the gun the tool lives inside your character, and MM2
    -- also parks round objects near players. Anything owned by a player is not
    -- a ground drop, so it can never raise the "gun dropped" alert.
    for _, OtherPlayer in ipairs(PlayersService:GetPlayers()) do
        local OtherCharacter = OtherPlayer.Character
        if OtherCharacter and GunObject:IsDescendantOf(OtherCharacter) then
            return false
        end
        local OtherBackpack = OtherPlayer:FindFirstChildOfClass("Backpack")
        if OtherBackpack and GunObject:IsDescendantOf(OtherBackpack) then
            return false
        end
    end

    -- a tool sitting in someone's hand is parented to their character
    if GunObject:IsA("Tool") and GunObject.Parent
        and GunObject.Parent:FindFirstChildOfClass("Humanoid") then
        return false
    end

    local AnchorPart = GetCandidateAnchor(GunObject)
    if not AnchorPart or AnchorPart.Transparency >= 1 then
        return false
    end

    -- a real drop lies on the map, it is never welded to a character assembly
    local AssemblyRoot = AnchorPart.AssemblyRootPart
    if AssemblyRoot and AssemblyRoot.Parent
        and AssemblyRoot.Parent:FindFirstChildOfClass("Humanoid") then
        return false
    end

    local HasPickup = HasPickupMarker(GunObject, AnchorPart)
    if HasDecorativeAncestor(GunObject) and not HasPickup then
        return false
    end

    local SpawnedDuringThisSession = RuntimeGunCandidates[GunObject] == true

    return HasPickup
        or (RoundIsLive and SpawnedDuringThisSession and not AnchorPart.Anchored)
end

local function GunInstanceIsValid(GunObject)
    return GunObject ~= nil
        and GunObject.Parent ~= nil
        and IsDroppedGunCandidate(GunObject)
end

LocateDroppedGun = function()
    if GunInstanceIsValid(CachedGunInstance) then
        return CachedGunInstance
    end
    CachedGunInstance = nil

    -- One deep pass at startup handles scripts injected mid-round. New drops
    -- are event-driven, so an empty workspace is never rescanned in a loop.
    if not InitialGunSearchFinished then
        InitialGunSearchFinished = true
        for _, Descendant in ipairs(workspace:GetDescendants()) do
            if GunDropNames[Descendant.Name] and IsDroppedGunCandidate(Descendant) then
                CachedGunInstance = Descendant
                return Descendant
            end
        end
    end
    return nil
end

GetGunAnchorPart = function()
    return GetCandidateAnchor(LocateDroppedGun())
end

ClearGunEsp = function()
    if GunHighlight then
        GunHighlight:Destroy()
        GunHighlight = nil
    end
    if GunTagBillboard then
        GunTagBillboard:Destroy()
        GunTagBillboard = nil
    end
end

local function RefreshGunEsp()
    if not CoreIsAlive or not GunEspEnabled then
        ClearGunEsp()
        return
    end

    local GunObject = LocateDroppedGun()
    local AnchorPart = GetGunAnchorPart()
    if not GunObject or not AnchorPart then
        ClearGunEsp()
        return
    end

    if not GunHighlight or GunHighlight.Parent ~= GunObject then
        if GunHighlight then
            GunHighlight:Destroy()
        end
        GunHighlight = Instance.new("Highlight")
        GunHighlight.Name = "BlackAlibiGunHighlight"
        GunHighlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        GunHighlight.FillColor = GunAccentColor
        GunHighlight.FillTransparency = 0.35
        GunHighlight.OutlineColor = GunAccentColor
        GunHighlight.OutlineTransparency = 0
        GunHighlight.Adornee = GunObject
        GunHighlight.Parent = GunObject
    end

    if not GunTagBillboard or GunTagBillboard.Adornee ~= AnchorPart then
        if GunTagBillboard then
            GunTagBillboard:Destroy()
        end
        GunTagBillboard = Instance.new("BillboardGui")
        GunTagBillboard.Name = "BlackAlibiGunTag"
        GunTagBillboard.Adornee = AnchorPart
        GunTagBillboard.Size = UDim2.fromOffset(120, 30)
        GunTagBillboard.StudsOffset = Vector3.new(0, 2, 0)
        GunTagBillboard.AlwaysOnTop = true
        GunTagBillboard.LightInfluence = 0
        GunTagBillboard.Parent = AnchorPart

        local GunTagText = Instance.new("TextLabel")
        GunTagText.Size = UDim2.fromScale(1, 1)
        GunTagText.BackgroundTransparency = 1
        GunTagText.Text = "GUN"
        GunTagText.TextColor3 = GunAccentColor
        GunTagText.Font = Enum.Font.Code
        GunTagText.TextSize = 15
        GunTagText.TextStrokeTransparency = 0
        GunTagText.TextStrokeColor3 = Color3.new(0, 0, 0)
        GunTagText.Parent = GunTagBillboard
    end
end

ApplyGunEspState = function(NewState)
    GunEspEnabled = NewState
    RefreshGunEsp()
end

-- one notification per drop, cleared once the gun is picked back up
local function HandleGunPresence()
    if not CoreIsAlive then
        return
    end

    local GunIsPresent = LocateDroppedGun() ~= nil
    if GunIsPresent and not GunIsOnGround then
        GunIsOnGround = true
        ShowNotification("GUN DROPPED", "The sheriff's revolver hit the ground.", GunAccentColor)

        -- the Extra tab can take it straight away
        if AutoGrabGunEnabled and TryAutoGrabGun then
            TryAutoGrabGun()
        end
    elseif not GunIsPresent and GunIsOnGround then
        GunIsOnGround = false
    end

    RefreshGunEsp()
end

-- name check first, so this costs almost nothing on a busy workspace
workspace.DescendantAdded:Connect(function(NewDescendant)
    local Candidate = GunDropNames[NewDescendant.Name] and NewDescendant or nil
    if not Candidate then
        local Current = NewDescendant.Parent
        while Current and Current ~= workspace do
            if GunDropNames[Current.Name] then
                Candidate = Current
                break
            end
            Current = Current.Parent
        end
    end
    if Candidate then
        RuntimeGunCandidates[Candidate] = true
        task.defer(function()
            if IsDroppedGunCandidate(Candidate) then
                CachedGunInstance = Candidate
                HandleGunPresence()
            end
        end)
    end
end)

workspace.DescendantRemoving:Connect(function(OldDescendant)
    if CachedGunInstance == OldDescendant
        or (CachedGunInstance and OldDescendant:IsDescendantOf(CachedGunInstance)) then
        CachedGunInstance = nil
        task.defer(HandleGunPresence)
    end
end)

-- ============ grab gun ============
-- One controlled move out and one move back. Repeating CFrame six times while
-- overlapping the gun used to inject a huge physics velocity into the body.
local GrabInProgress = false

local function GetLocalRootPart()
    local Character = LocalPlayer.Character
    if not Character then
        return nil
    end
    return Character:FindFirstChild("HumanoidRootPart")
end

RunGrabGun = function()
    if GrabInProgress then
        return
    end

    local RootPart = GetLocalRootPart()
    if not RootPart then
        SetTeleportStatus("NO CHARACTER LOADED", Color3.fromRGB(235, 110, 110))
        return
    end

    local AnchorPart = GetGunAnchorPart()
    if not AnchorPart then
        SetTeleportStatus("NO GUN ON THE GROUND", Color3.fromRGB(235, 110, 110))
        return
    end

    GrabInProgress = true
    SetTeleportStatus("GRABBING THE GUN ...", Color3.fromRGB(150, 190, 255))

    task.spawn(function()
        local Character = LocalPlayer.Character
        local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
        if not Character or RootPart.Parent ~= Character then
            GrabInProgress = false
            SetTeleportStatus("CHARACTER CHANGED · TRY AGAIN", Color3.fromRGB(235, 110, 110))
            return
        end

        local ReturnPivot = Character:GetPivot()
        local PreviousAutoRotate = Humanoid and Humanoid.AutoRotate
        local TouchFunction = firetouchinterest or (syn and syn.firetouchinterest)

        local function StopCharacterPhysics()
            if RootPart and RootPart.Parent then
                RootPart.AssemblyLinearVelocity = Vector3.zero
                RootPart.AssemblyAngularVelocity = Vector3.zero
            end
        end

        local PickupSucceeded, PickupError = pcall(function()
            if Humanoid then
                Humanoid.AutoRotate = false
            end
            StopCharacterPhysics()

            -- Put the feet on the pickup instead of placing the root inside it.
            local PickupHeight = Humanoid
                and math.max(2.5, Humanoid.HipHeight + (RootPart.Size.Y * 0.5) + 0.35)
                or 3
            local PickupCFrame = AnchorPart.CFrame + Vector3.new(0, PickupHeight, 0)
            Character:PivotTo(PickupCFrame)
            StopCharacterPhysics()
            task.wait(0.12)

            -- One explicit touch is enough on executors that expose the API.
            if TouchFunction then
                TouchFunction(RootPart, AnchorPart, 0)
                task.wait()
                TouchFunction(RootPart, AnchorPart, 1)
            end
            task.wait(0.18)
        end)

        -- This cleanup runs even if firetouchinterest throws an executor error.
        if Character.Parent and RootPart.Parent == Character then
            StopCharacterPhysics()
            Character:PivotTo(ReturnPivot)
            StopCharacterPhysics()
        end
        if Humanoid and Humanoid.Parent then
            Humanoid.AutoRotate = PreviousAutoRotate
        end

        GrabInProgress = false

        if not PickupSucceeded then
            SetTeleportStatus("PICKUP ERROR · BACK IN PLACE", Color3.fromRGB(235, 110, 110))
            warn("Black Alibi grab error: " .. tostring(PickupError))
        elseif GunInstanceIsValid(CachedGunInstance) then
            SetTeleportStatus("BACK IN PLACE · GUN STILL THERE", Color3.fromRGB(235, 180, 110))
        else
            SetTeleportStatus("GUN TAKEN · BACK IN PLACE", Color3.fromRGB(120, 210, 140))
            ShowNotification("GUN GRABBED", "Revolver picked up, you are back in place.", GunAccentColor)
        end
    end)
end
end
