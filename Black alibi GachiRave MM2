-- ---------- knife throw ----------
-- reworked end to end. the old version could happily "touch" with a knife
-- that was still sitting in the backpack, which never registers a kill.
-- now the knife is equipped first, you pivot to face the target, and the
-- touch lands on the torso (UpperTorso / Torso), not the head.
local function GetEquippedKnife()
    local Character = LocalPlayer.Character
    if not Character then
        return nil
    end
    local HeldKnife = Character:FindFirstChild("Knife")
    if HeldKnife and HeldKnife:IsA("Tool") then
        return HeldKnife
    end
    return nil
end

local function EnsureKnifeInHand()
    local EquippedKnife = GetEquippedKnife()
    if EquippedKnife then
        return EquippedKnife
    end

    local Backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    local PackedKnife = Backpack and Backpack:FindFirstChild("Knife")
    local Humanoid = GetLocalHumanoid()

    if PackedKnife and Humanoid then
        Humanoid:EquipTool(PackedKnife)
        task.wait(0.18) -- the tool needs a beat to land in the hand
        return GetEquippedKnife()
    end
    return nil
end

local function GetBodyAimPart(TargetCharacter)
    return TargetCharacter:FindFirstChild("UpperTorso")
        or TargetCharacter:FindFirstChild("Torso")
        or TargetCharacter:FindFirstChild("HumanoidRootPart")
end

local function FindKnifeThrowTarget(RootPart)
    local KNIFE_THROW_MAX_RANGE = 65

    local BestSheriffPlayer, BestSheriffTorso, BestSheriffDistance
    local BestAnyPlayer, BestAnyTorso, BestAnyDistance

    for _, OtherPlayer in ipairs(PlayersService:GetPlayers()) do
        if OtherPlayer ~= LocalPlayer then
            local OtherCharacter = OtherPlayer.Character
            local OtherTorso = OtherCharacter and GetBodyAimPart(OtherCharacter)
            local OtherHumanoid = OtherCharacter and OtherCharacter:FindFirstChildOfClass("Humanoid")

            if OtherTorso and OtherHumanoid and OtherHumanoid.Health > 0 then
                local Distance = (OtherTorso.Position - RootPart.Position).Magnitude
                if Distance <= KNIFE_THROW_MAX_RANGE and TargetIsVisible(RootPart.Position, OtherTorso) then
                    local RoleKey = GetRoleOfPlayer and GetRoleOfPlayer(OtherPlayer)

                    if RoleKey == "Sheriff" and (not BestSheriffDistance or Distance < BestSheriffDistance) then
                        BestSheriffPlayer, BestSheriffTorso, BestSheriffDistance = OtherPlayer, OtherTorso, Distance
                    end
                    if not BestAnyDistance or Distance < BestAnyDistance then
                        BestAnyPlayer, BestAnyTorso, BestAnyDistance = OtherPlayer, OtherTorso, Distance
                    end
                end
            end
        end
    end

    -- the sheriff always wins the pick when one is out in the open
    if BestSheriffTorso then
        return BestSheriffPlayer, BestSheriffTorso
    end
    return BestAnyPlayer, BestAnyTorso
end

local function RunKnifeThrow()
    local Character = LocalPlayer.Character
    local RootPart = Character and Character:FindFirstChild("HumanoidRootPart")
    local TouchFunction = firetouchinterest or (syn and syn.firetouchinterest)

    if not RootPart then
        if ShowNotification then
            ShowNotification("KNIFE THROW", "No character loaded.", Color3.fromRGB(255, 72, 72))
        end
        return
    end

    task.spawn(function()
        local Knife = EnsureKnifeInHand()
        local Handle = Knife and Knife:FindFirstChild("Handle")

        if not Handle then
            if ShowNotification then
                ShowNotification("KNIFE THROW", "No knife this round.", Color3.fromRGB(255, 72, 72))
            end
            return
        end

        local TargetPlayer, TargetTorso = FindKnifeThrowTarget(RootPart)
        if not TargetPlayer or not TargetTorso then
            if ShowNotification then
                ShowNotification("KNIFE THROW", "No clear target in range.", Color3.fromRGB(235, 180, 110))
            end
            return
        end

        -- face the body first so the swing reads like a real throw
        local FlatAimPoint = Vector3.new(TargetTorso.Position.X, RootPart.Position.Y, TargetTorso.Position.Z)
        pcall(function()
            RootPart.CFrame = CFrame.lookAt(RootPart.Position, FlatAimPoint)
            RootPart.AssemblyLinearVelocity = Vector3.zero
        end)

        -- if the game exposes a throw remote, ping it too; harmless if absent
        pcall(function()
            local ThrowRemote = ReplicatedStorageService:FindFirstChild("Throw", true)
                or ReplicatedStorageService:FindFirstChild("ThrowKnife", true)
            if ThrowRemote and ThrowRemote:IsA("RemoteEvent") then
                ThrowRemote:FireServer(TargetTorso.Position)
            end
        end)

        RunService.Heartbeat:Wait()

        -- this touch is what actually kills: straight into the torso
        if TouchFunction then
            pcall(function()
                TouchFunction(TargetTorso, Handle, 0)
            end)
            RunService.Heartbeat:Wait()
            pcall(function()
                TouchFunction(TargetTorso, Handle, 1)
            end)
        end

        if ShowNotification then
            ShowNotification("KNIFE THROW", "Thrown at " .. TargetPlayer.Name .. " · torso.", Color3.fromRGB(255, 120, 120))
        end
    end)
end

