-- ============ minimize / expand ============
-- transition token: a stale Completed callback can no longer hide the
-- window that was already brought back.
local ViewToken = 0
local IsMinimized = false

local function MinimizeMenu()
    if IsMinimized then
        return
    end
    IsMinimized = true
    ViewToken = ViewToken + 1
    local MyToken = ViewToken

    SetBackdrop(false)
    Animate(WindowScale, TweenFast, {Scale = 0.96})

    local FadeWindow = TweenService:Create(MainWindow, TweenFast, {GroupTransparency = 1})
    FadeWindow:Play()
    FadeWindow.Completed:Connect(function()
        if CoreIsAlive and MyToken == ViewToken and IsMinimized then
            MainWindow.Visible = false
        end
    end)

    MinimizeBar.Visible = true
    Animate(MinimizeBar, TweenSlow, {GroupTransparency = 0})
end

local function ExpandMenu()
    if not IsMinimized then
        return
    end
    IsMinimized = false
    ViewToken = ViewToken + 1
    local MyToken = ViewToken

    -- always snap back to the middle of the screen, wherever it was dragged
    MainWindow.Position = UDim2.fromScale(0.5, 0.5)
    MainWindow.Visible = true
    MainWindow.GroupTransparency = 1
    WindowScale.Scale = 0.96

    SetBackdrop(true)
    Animate(MainWindow, TweenSlow, {GroupTransparency = 0})
    Animate(WindowScale, TweenSlow, {Scale = 1})

    local FadeBar = TweenService:Create(MinimizeBar, TweenFast, {GroupTransparency = 1})
    FadeBar:Play()
    FadeBar.Completed:Connect(function()
        if CoreIsAlive and MyToken == ViewToken and not IsMinimized then
            MinimizeBar.Visible = false
        end
    end)
end

