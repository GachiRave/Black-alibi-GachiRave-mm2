        for TargetPlayer, HighlightInstance in pairs(EspHighlights) do
            HighlightInstance:Destroy()
            EspHighlights[TargetPlayer] = nil
        end
    end
    ScanEveryone()
end

ApplyNameTagState = function(NewState)
