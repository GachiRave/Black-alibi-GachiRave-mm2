-- finding the map: four strategies in order of reliability, first hit wins
local function FindRoundMapPivot()
    -- 1. a spawn container inside a map folder is the cleanest landing spot
    for _, FolderName in ipairs({"Map", "Maps", "Normal", "GameMap", "CurrentMap", "MapFolder"}) do
        local Folder = workspace:FindFirstChild(FolderName)
        if Folder then
            for _, SpawnName in ipairs({"Spawns", "SpawnPoints", "PlayerSpawns", "Spawn"}) do
                local SpawnHolder = Folder:FindFirstChild(SpawnName, true)
                if SpawnHolder then
                    local SpawnPart = SpawnHolder:IsA("BasePart")
                        and SpawnHolder
                        or SpawnHolder:FindFirstChildWhichIsA("BasePart", true)
                    if SpawnPart then
                        return SpawnPart.CFrame
                    end
                end
            end

            local AnyMapPart = Folder:FindFirstChildWhichIsA("BasePart", true)
            if AnyMapPart then
                return AnyMapPart.CFrame
            end
        end
    end

    -- 2. coins only exist on an active map
    for _, Descendant in ipairs(workspace:GetDescendants()) do
        if Descendant:IsA("BasePart") then
            local LowerName = string.lower(Descendant.Name)
            if LowerName == "coin" or LowerName == "coin_server" or LowerName == "coincontainer" then
                return Descendant.CFrame
            end
        end
    end

    -- 3. a player with a resolved round role is on the map; Unknown players
    -- can still be standing in the lobby, so skip them
    for _, OtherPlayer in ipairs(PlayersService:GetPlayers()) do
        local OtherRole = GetRoleOfPlayer and GetRoleOfPlayer(OtherPlayer)
        if OtherPlayer ~= LocalPlayer and OtherRole and OtherRole ~= "Unknown" then
            local OtherCharacter = OtherPlayer.Character
            local OtherRoot = OtherCharacter and OtherCharacter:FindFirstChild("HumanoidRootPart")
            if OtherRoot then
                return OtherRoot.CFrame * CFrame.new(0, 0, 6)
            end
        end
    end

    -- 4. the dropped gun is always lying on the map
    if LocateDroppedGun then
        local AnchorPart = GetGunAnchorPart and GetGunAnchorPart()
        if AnchorPart then
            return AnchorPart.CFrame
        end
    end

    return nil
end

local function ObjectIsInsideActiveMap(TargetObject)
    for _, FolderName in ipairs({"Map", "Maps", "Normal", "GameMap", "CurrentMap", "MapFolder"}) do
        local MapFolder = workspace:FindFirstChild(FolderName)
        if MapFolder and TargetObject:IsDescendantOf(MapFolder) then
            return true
        end
    end
    return false
end

local function FindLobbyPivot()
    for _, LobbyName in ipairs({"Lobby", "LobbySpawn", "VotingRoom", "VotingArea"}) do
        local LobbyObject = workspace:FindFirstChild(LobbyName, true)
        if LobbyObject then
            if LobbyObject:IsA("BasePart") then
                return LobbyObject.CFrame
            end
            local LobbyPart = LobbyObject:FindFirstChildWhichIsA("BasePart", true)
            if LobbyPart then
                return LobbyPart.CFrame
            end
        end
    end

    for _, Child in ipairs(workspace:GetChildren()) do
        if Child:IsA("SpawnLocation") then
            return Child.CFrame
        end
    end

    -- last resort: any spawn not living inside an active map folder
    for _, Descendant in ipairs(workspace:GetDescendants()) do
        if Descendant:IsA("SpawnLocation") and not ObjectIsInsideActiveMap(Descendant) then
            return Descendant.CFrame
        end
    end
    return nil
end

