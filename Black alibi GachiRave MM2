-- configs go through the executor file api when it exists; without it they
-- still work for the session, they just don't survive a relaunch
local CONFIG_FOLDER = "BlackAlibiMM2"
local HttpServiceForJson = game:GetService("HttpService")

local FileWrite = writefile
local FileRead = readfile
local FileDelete = delfile
local FileExists = isfile
local FolderExists = isfolder
local FolderCreate = makefolder
local FolderList = listfiles

local FileApiAvailable = (FileWrite and FileRead and FileExists) and true or false
local SessionConfigStore = {}
local SelectedConfigName = nil

if FileApiAvailable and FolderExists and FolderCreate then
    local FolderCheckSucceeded, ConfigFolderExists = pcall(FolderExists, CONFIG_FOLDER)
    if FolderCheckSucceeded and not ConfigFolderExists then
        pcall(FolderCreate, CONFIG_FOLDER)
    end
end

local function GetConfigPath(ConfigName)
    return CONFIG_FOLDER .. "/" .. ConfigName .. ".json"
end

local function ListSavedConfigs()
    local Names = {}

    if FileApiAvailable and FolderList then
        local Ok, Files = pcall(FolderList, CONFIG_FOLDER)
        if Ok and Files then
            for _, FilePath in ipairs(Files) do
                local Name = string.match(FilePath, "([^/" .. string.char(92) .. "]+)%.json$")
                if Name then
                    table.insert(Names, Name)
                end
            end
        end
    end

    for Name in pairs(SessionConfigStore) do
        local AlreadyListed = false
        for _, Existing in ipairs(Names) do
            if Existing == Name then
                AlreadyListed = true
                break
            end
        end
        if not AlreadyListed then
            table.insert(Names, Name)
        end
    end

    table.sort(Names)
    return Names
end

