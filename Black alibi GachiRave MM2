    local function RenderState()
        Animate(Row, TweenFast, {BackgroundColor3 = IsEnabled and Palette.AccentSoft or Color3.fromRGB(30, 30, 35)})
        Animate(RowStroke, TweenFast, {Color = IsEnabled and Palette.Accent or Palette.Stroke, Transparency = IsEnabled and 0.3 or 0.45})
        Animate(StatePill, TweenFast, {BackgroundColor3 = IsEnabled and Palette.Accent or Color3.fromRGB(40, 40, 47)})
        StatePill.Text = IsEnabled and "ON" or "OFF"
        StatePill.TextColor3 = IsEnabled and Color3.fromRGB(255, 255, 255) or Palette.TextFaint
    end

    Row.InputBegan:Connect(function(Input)
        if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
            Animate(RowScale, TweenFast, {Scale = 0.98})
        end
    end)
    Row.InputEnded:Connect(function(Input)
        if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
            Animate(RowScale, TweenFast, {Scale = 1})
        end
    end)

    Row.Activated:Connect(function()
        IsEnabled = not IsEnabled
        RenderState()
        OnStateChanged(IsEnabled)
    end)

    local function SetState(ShouldBeEnabled)
        ShouldBeEnabled = ShouldBeEnabled and true or false
        if ShouldBeEnabled == IsEnabled then
            return
        end
        IsEnabled = ShouldBeEnabled
        RenderState()
        OnStateChanged(IsEnabled)
    end

    -- same rule as the page toggles: hand back only the setter
    return SetState
end

