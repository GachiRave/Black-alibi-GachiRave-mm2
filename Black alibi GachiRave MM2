-- ---- x-ray ----
-- Walls are faded, not deleted. Original transparency is stored per part so
-- toggling off restores the map exactly as the game built it.
local XRayEnabled = false
local DisableXRay

Builders.XRay = function()
local XRayOriginalTransparency = {}
local XRayDescendantConnection = nil

local function PartIsMapGeometry(TargetPart)
    if not TargetPart:IsA("BasePart") then
        return false
    end

    -- Accessories are nested below the character model, so checking only the
    -- direct parent faded hats and layered clothing in the old build.
    local AncestorModel = TargetPart:FindFirstAncestorOfClass("Model")
    if AncestorModel and PlayersService:GetPlayerFromCharacter(AncestorModel) then
        return false
    end
    if TargetPart:FindFirstAncestorWhichIsA("Tool") then
        return false
    end

    local DroppedGun = LocateDroppedGun and LocateDroppedGun()
    if DroppedGun and (TargetPart == DroppedGun or TargetPart:IsDescendantOf(DroppedGun)) then
        return false
    end

    if TargetPart.Transparency >= 1 then
        return false -- already invisible, leave it alone
    end
    return true
end

local function ApplyXRayToPart(TargetPart)
    if XRayOriginalTransparency[TargetPart] ~= nil then
        return
    end
    XRayOriginalTransparency[TargetPart] = TargetPart.Transparency
    TargetPart.Transparency = 0.72
end

local function EnableXRay()
    for _, Descendant in ipairs(workspace:GetDescendants()) do
        if PartIsMapGeometry(Descendant) then
            ApplyXRayToPart(Descendant)
        end
    end

    -- new map pieces stream in as the round loads
    XRayDescendantConnection = workspace.DescendantAdded:Connect(function(NewDescendant)
        if XRayEnabled and PartIsMapGeometry(NewDescendant) then
            task.defer(function()
                if XRayEnabled and NewDescendant.Parent then
                    ApplyXRayToPart(NewDescendant)
                end
            end)
        end
    end)
end

DisableXRay = function()
    if XRayDescendantConnection then
        XRayDescendantConnection:Disconnect()
        XRayDescendantConnection = nil
    end
    for TargetPart, OriginalValue in pairs(XRayOriginalTransparency) do
        if TargetPart and TargetPart.Parent then
            TargetPart.Transparency = OriginalValue
        end
    end
    table.clear(XRayOriginalTransparency)
end

Setters.XRay = CreateToggleRow(PageEsp, "X-RAY", 152, function(NewState)
    XRayEnabled = NewState
    if NewState then
        EnableXRay()
    else
        DisableXRay()
    end
end)
end
