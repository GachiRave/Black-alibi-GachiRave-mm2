-- AUTO ESCAPE: twelve routes, ground checked, never into a wall
local EscapeOn = false
local StopEscape

do
    local Conn = nil
    local TRIGGER = 35
    local REACH = 95
    local COOLDOWN = 2
    local NextRun = 0

    local function RayParams(MurdRoot)
        local P = RaycastParams.new()
        local Ok = pcall(function() P.FilterType = Enum.RaycastFilterType.Exclude end)
        if not Ok then
            pcall(function() P.FilterType = Enum.RaycastFilterType.Blacklist end)
        end
        local Ignore = {}
        if LocalPlayer.Character then table.insert(Ignore, LocalPlayer.Character) end
        if MurdRoot and MurdRoot.Parent then table.insert(Ignore, MurdRoot.Parent) end
        P.FilterDescendantsInstances = Ignore
        P.IgnoreWater = true
        return P
    end

    local function Solve(Root, MurdRoot)
        local Params = RayParams(MurdRoot)
        local Origin = Root.Position + Vector3.new(0, 2, 0)

        local Away = Root.Position - MurdRoot.Position
        Away = Vector3.new(Away.X, 0, Away.Z)
        if Away.Magnitude < 0.5 then
            Away = Vector3.new(Root.CFrame.LookVector.X, 0, Root.CFrame.LookVector.Z)
        end
        if Away.Magnitude < 0.5 then Away = Vector3.new(0, 0, 1) end
        Away = Away.Unit

        local Best, BestScore = nil, -math.huge

        for Step = 0, 11 do
            local Dir = CFrame.fromAxisAngle(Vector3.yAxis, math.rad(Step * 30)):VectorToWorldSpace(Away)

            local Reach = REACH
            local Wall
            pcall(function() Wall = workspace:Raycast(Origin, Dir * REACH, Params) end)
            if Wall then Reach = (Wall.Position - Origin).Magnitude - 4 end

            if Reach >= 12 then
                local Candidate = Origin + (Dir * Reach)
                local Floor
                pcall(function()
                    Floor = workspace:Raycast(Candidate + Vector3.new(0, 6, 0), Vector3.new(0, -60, 0), Params)
                end)
                if Floor then
                    local Land = Floor.Position + Vector3.new(0, 3.5, 0)
                    local Score = (Land - MurdRoot.Position).Magnitude + (Reach * 0.25)
                    if Score > BestScore then
                        BestScore, Best = Score, Land
                    end
                end
            end
        end
        return Best
    end

    StopEscape = function()
        if Conn then
            Conn:Disconnect()
            Conn = nil
        end
    end

    Setters.Escape = ToggleRow(PageExtra, "АВТО ПОБЕГ ОТ УБИЙЦЫ", 72, function(S)
        EscapeOn = S
        if not S then
            StopEscape()
            return
        end

        Conn = RunService.Heartbeat:Connect(function()
            if not Alive or not EscapeOn then return end
            if os.clock() < NextRun then return end

            local Char = LocalPlayer.Character
            local Root = Char and Char:FindFirstChild("HumanoidRootPart")
            local H = Char and Char:FindFirstChildOfClass("Humanoid")
            if not Root or not H or H.Health <= 0 or not GetRole then return end

            local MurdRoot, Dist
            for _, Other in ipairs(PlayersService:GetPlayers()) do
                if Other ~= LocalPlayer and GetRole(Other) == "Murderer" then
                    local OC = Other.Character
                    local OR = OC and OC:FindFirstChild("HumanoidRootPart")
                    local OH = OC and OC:FindFirstChildOfClass("Humanoid")
                    if OR and OH and OH.Health > 0 then
                        local D = (OR.Position - Root.Position).Magnitude
                        if not Dist or D < Dist then
                            MurdRoot, Dist = OR, D
                        end
                    end
                end
            end

            if not MurdRoot or Dist > TRIGGER then return end

            local Spot = Solve(Root, MurdRoot)
            if not Spot then
                NextRun = os.clock() + 0.5
                return
            end

            NextRun = os.clock() + COOLDOWN
