local function SetBackdrop(ShouldShow)
    BackdropShown = ShouldShow
    if ShouldShow then
        DimLayer.Visible = true
        Animate(DimLayer, TweenSlow, {BackgroundTransparency = 0.45})
        Animate(BackdropBlur, TweenSlow, {Size = 12})
    else
        Animate(DimLayer, TweenFast, {BackgroundTransparency = 1})
