do
    local Running = false

    local function RunKillAll()
        if Running then return end

        local Knife = EquipKnife()
        local Touch = firetouchinterest or (syn and syn.firetouchinterest)
        if not Knife or not Knife:FindFirstChild("Handle") or not Touch then
            Notify("KILL ALL", "Нужен нож в руках.", Palette.Accent)
            return
        end

        local Char = LocalPlayer.Character
        local Root = Char and Char:FindFirstChild("HumanoidRootPart")
        if not Char or not Root then return end

        Running = true

        task.spawn(function()
            -- fixed roster: someone leaving mid sweep cannot shift indices
            local Roster = {}
            for _, Other in ipairs(PlayersService:GetPlayers()) do
                if Other ~= LocalPlayer then table.insert(Roster, Other) end
            end

            local Home = Char:GetPivot()
            local Killed = 0

            local Ok, Err = pcall(function()
                for _, Other in ipairs(Roster) do
                    if not Alive or not Running then break end

                    -- knife re-read every loop, the round can end mid sweep
                    local Blade = HeldKnife()
                    local Handle = Blade and Blade:FindFirstChild("Handle")
                    if not Handle or not Handle.Parent then break end
                    if not Char.Parent or not Root.Parent then break end

                    local OC = Other.Character
                    local OR = OC and OC:FindFirstChild("HumanoidRootPart")
                    local OH = OC and OC:FindFirstChildOfClass("Humanoid")

                    if OR and OH and OH.Health > 0 then
                        local Moved = pcall(function()
                            Char:PivotTo(OR.CFrame * CFrame.new(0, 0, 2))
                            Root.AssemblyLinearVelocity = Vector3.zero
                            Root.AssemblyAngularVelocity = Vector3.zero
                        end)

                        RunService.Heartbeat:Wait()

                        if Moved and OR.Parent then
                            KnifeHit(Blade, OR)
                            Killed = Killed + 1
                        end

                        RunService.Heartbeat:Wait()
                    end
                end
            end)

            if Char.Parent and Root.Parent == Char then
                pcall(function()
                    Char:PivotTo(Home)
                    Root.AssemblyLinearVelocity = Vector3.zero
                    Root.AssemblyAngularVelocity = Vector3.zero
                end)
            end

            Running = false

            if not Ok then
