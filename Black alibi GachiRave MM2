RadarNameLabel.ZIndex = 31
RadarNameLabel.Parent = RadarHolder

local RadarDistanceLabel = Instance.new("TextLabel")
RadarDistanceLabel.Size = UDim2.new(1, -10, 0, 13)
RadarDistanceLabel.AnchorPoint = Vector2.new(0.5, 0)
RadarDistanceLabel.Position = UDim2.new(0.5, 0, 0, 45)
RadarDistanceLabel.BackgroundTransparency = 1
RadarDistanceLabel.Text = "— STUDS"
RadarDistanceLabel.TextColor3 = Palette.TextFaint
RadarDistanceLabel.Font = Enum.Font.Code
RadarDistanceLabel.TextSize = 10
RadarDistanceLabel.ZIndex = 31
RadarDistanceLabel.Parent = RadarHolder

local RadarConnection = nil
local CurrentNeedleAngle = 0

local function FindMurdererForRadar()
    if not GetRoleOfPlayer then
        return nil, nil
    end
    for _, OtherPlayer in ipairs(PlayersService:GetPlayers()) do
        if OtherPlayer ~= LocalPlayer and GetRoleOfPlayer(OtherPlayer) == "Murderer" then
            local OtherCharacter = OtherPlayer.Character
            local OtherRoot = OtherCharacter and OtherCharacter:FindFirstChild("HumanoidRootPart")
            if OtherRoot then
                return OtherPlayer, OtherRoot
            end
        end
    end
    return nil, nil
end

StopMurdererRadar = function()
    if RadarConnection then
        RadarConnection:Disconnect()
        RadarConnection = nil
    end
    CurrentNeedleAngle = 0
    RadarHolder.Visible = false
end

local function StartRadarLoop()
    if RadarConnection then
        return
    end
    RadarHolder.Visible = true

    RadarConnection = RunService.RenderStepped:Connect(function(DeltaTime)
        if not CoreIsAlive or not MurdererRadarEnabled then
            return
        end

        local Character = LocalPlayer.Character
        local RootPart = Character and Character:FindFirstChild("HumanoidRootPart")
        local ActiveCamera = workspace.CurrentCamera
        local MurdererPlayer, MurdererRoot = FindMurdererForRadar()

        if not MurdererRoot or not RootPart or not ActiveCamera then
            RadarNameLabel.Text = "NO MURDERER YET"
            RadarDistanceLabel.Text = "— STUDS"
            RadarDistanceLabel.TextColor3 = Palette.TextFaint
            RadarStroke.Transparency = 0.55
            return
        end

        -- flatten everything onto the ground plane
        local ToTarget = MurdererRoot.Position - RootPart.Position
        local FlatToTarget = Vector3.new(ToTarget.X, 0, ToTarget.Z)
        local FlatForward = Vector3.new(ActiveCamera.CFrame.LookVector.X, 0, ActiveCamera.CFrame.LookVector.Z)
        local FlatRight = Vector3.new(ActiveCamera.CFrame.RightVector.X, 0, ActiveCamera.CFrame.RightVector.Z)

        -- right-vector dot is positive when the target sits right of the
        -- camera, so atan2 maps straight onto a clockwise gui rotation
        if FlatToTarget.Magnitude > 0.1 and FlatForward.Magnitude > 0.01 and FlatRight.Magnitude > 0.01 then
            local TargetAngle = math.deg(math.atan2(FlatToTarget:Dot(FlatRight), FlatToTarget:Dot(FlatForward)))

            -- unwrap onto the shortest path so the needle never spins the long way round
            local AngleDifference = (TargetAngle - CurrentNeedleAngle) % 360
            if AngleDifference > 180 then
                AngleDifference = AngleDifference - 360
            elseif AngleDifference < -180 then
                AngleDifference = AngleDifference + 360
            end

            local NeedleBlend = 1 - math.exp(-14 * math.clamp(DeltaTime, 0, 0.1))
            CurrentNeedleAngle = CurrentNeedleAngle + AngleDifference * NeedleBlend
            RadarArrow.Rotation = CurrentNeedleAngle
        end

        local Distance = math.floor(ToTarget.Magnitude)
        RadarNameLabel.Text = string.upper(MurdererPlayer.Name)
        RadarDistanceLabel.Text = tostring(Distance) .. " STUDS"

        -- since the danger overlay is gone, closeness shows up right here
        local MurdererIsClose = Distance <= 25
        RadarDistanceLabel.TextColor3 = MurdererIsClose and Color3.fromRGB(255, 96, 96) or Palette.TextFaint
        RadarStroke.Transparency = MurdererIsClose and 0.1 or 0.35
    end)
end

Setters.MurdererRadar = CreateToggleRow(PageEsp, "MURDERER RADAR", 190, function(NewState)
    MurdererRadarEnabled = NewState
    if NewState then
        StartRadarLoop()
    else
        StopMurdererRadar()
    end
end)
end
