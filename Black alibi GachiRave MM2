do
    local Fab = nil
    local Busy = false
    local MAX_RANGE = 70

    -- sheriff first when the switch is on and one is in the open
    local function PickTarget(Root)
        local BestSheriff, BestSheriffDist
        local BestAny, BestAnyDist

        for _, Other in ipairs(PlayersService:GetPlayers()) do
            if Other ~= LocalPlayer then
                local OC = Other.Character
                local Body = OC and BodyPart(OC)
                local OH = OC and OC:FindFirstChildOfClass("Humanoid")

                if Body and OH and OH.Health > 0 then
                    local Dist = (Body.Position - Root.Position).Magnitude
                    if Dist <= MAX_RANGE and CanSee(Root.Position + Vector3.new(0, 1.5, 0), Body) then
                        local Role = GetRole and GetRole(Other)
                        if Role == "Sheriff" and (not BestSheriffDist or Dist < BestSheriffDist) then
                            BestSheriff, BestSheriffDist = {Other, Body}, Dist
                        end
                        if not BestAnyDist or Dist < BestAnyDist then
                            BestAny, BestAnyDist = {Other, Body}, Dist
                        end
                    end
                end
            end
        end

        if SheriffFirstOn and BestSheriff then
            return BestSheriff[1], BestSheriff[2], true
        end
        if BestAny then
            return BestAny[1], BestAny[2], false
        end
        return nil
    end

    local function RunThrow()
        if Busy then return end

        local Char = LocalPlayer.Character
        local Root = Char and Char:FindFirstChild("HumanoidRootPart")
        if not Root then return end

        Busy = true
        task.spawn(function()
            local Knife = EquipKnife()
            if not Knife or not Knife:FindFirstChild("Handle") then
                Notify("НОЖ", "Ножа нет в этом раунде.", Palette.Accent)
                Busy = false
                return
            end

            local Target, Body, WasSheriff = PickTarget(Root)
            if not Target or not Body then
                Notify("НОЖ", "Нет цели на виду.", Color3.fromRGB(235, 180, 110))
                Busy = false
                return
            end

            -- a touch only counts when the handle really overlaps the body,
            -- so step in, hit, and drop straight back
            local Home = Char:GetPivot()

            pcall(function()
                Char:PivotTo(CFrame.new(
                    Body.Position - (Body.CFrame.LookVector * 2.2),
                    Body.Position
                ))
                Root.AssemblyLinearVelocity = Vector3.zero
            end)

            RunService.Heartbeat:Wait()
            KnifeHit(Knife, Body)
            RunService.Heartbeat:Wait()

            if Char.Parent then
                pcall(function()
                    Char:PivotTo(Home)
                    Root.AssemblyLinearVelocity = Vector3.zero
                    Root.AssemblyAngularVelocity = Vector3.zero
                end)
            end

            Notify("НОЖ", (WasSheriff and "Шериф: " or "Цель: ") .. Target.Name, Palette.Accent)
            Busy = false
        end)
    end

