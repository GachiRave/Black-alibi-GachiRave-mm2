-- ---- scan ----
ScanEveryone = function()
    if not CoreIsAlive then
        return
    end

    RefreshGunDropState()

    local AssignedCount = 0
    local TrackedCount = 0

    for _, TargetPlayer in ipairs(PlayersService:GetPlayers()) do
        if TargetPlayer ~= LocalPlayer then
            TrackedCount = TrackedCount + 1

            local NewRole = ResolveRoleFor(TargetPlayer)
            if NewRole ~= "Unknown" then
                AssignedCount = AssignedCount + 1
            end

            RoleByPlayer[TargetPlayer] = NewRole
            PaintEspFor(TargetPlayer, NewRole)
        end
    end

    -- nobody holds an assigned role any more: the round is over
    if RoundIsLive and AssignedCount == 0 then
        RoundIsLive = false
        ActiveRoleSource = "WAITING"
        RoundSheriffUserId = nil
        GunWasDropped = false
        table.clear(RoleFromPacket)
        table.clear(JoinedMidRound)
    end

    if RefreshMyRoleHud then
        RefreshMyRoleHud()
    end

    ScanCounterLabel.Text = "SCAN · " .. TrackedCount .. " TRACKED"
    RoleSourceLabel.Text = "SOURCE : " .. ActiveRoleSource

    if RoundIsLive then
        RoundStateLabel.Text = "ROUND : LIVE · " .. AssignedCount .. " ROLES RECEIVED"
        RoundStateLabel.TextColor3 = Color3.fromRGB(120, 170, 255)
    else
        RoundStateLabel.Text = "ROUND : LOBBY · WAITING FOR ROLES"
        RoundStateLabel.TextColor3 = Palette.TextFaint
    end
end

-- react the instant a tool lands in a backpack or in a hand
local function WatchPlayer(TargetPlayer)
    if WatchedContainers[TargetPlayer] then
        return
    end
    WatchedContainers[TargetPlayer] = true

    if RoundIsLive then
        JoinedMidRound[TargetPlayer] = true
    end

    TargetPlayer.ChildAdded:Connect(function(Child)
        if Child:IsA("Backpack") then
            Child.ChildAdded:Connect(ScanEveryone)
            Child.ChildRemoved:Connect(ScanEveryone)
        end
    end)

    local ExistingBackpack = TargetPlayer:FindFirstChildOfClass("Backpack")
    if ExistingBackpack then
        ExistingBackpack.ChildAdded:Connect(ScanEveryone)
        ExistingBackpack.ChildRemoved:Connect(ScanEveryone)
    end

    TargetPlayer.CharacterAdded:Connect(function(NewCharacter)
        DestroyEspFor(TargetPlayer)
        NewCharacter.ChildAdded:Connect(ScanEveryone)
        NewCharacter.ChildRemoved:Connect(ScanEveryone)
        task.delay(0.35, ScanEveryone)
    end)

    if TargetPlayer.Character then
        TargetPlayer.Character.ChildAdded:Connect(ScanEveryone)
        TargetPlayer.Character.ChildRemoved:Connect(ScanEveryone)
    end
end

for _, ExistingPlayer in ipairs(PlayersService:GetPlayers()) do
