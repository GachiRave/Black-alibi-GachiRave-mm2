-- AUTO ESCAPE.
-- the killer gets inside sixteen studs and you get thrown clear of him.
-- the escape vector is raycast first, so you land in open floor instead of
-- inside a wall, and a cooldown keeps it from stuttering you across the map.
Builders.AutoEscape = function()
local EscapeConnection = nil
local ESCAPE_TRIGGER_RADIUS = 16
local ESCAPE_DISTANCE = 60
local ESCAPE_COOLDOWN = 2.5
local NextEscapeTime = 0

local function FindNearestMurderer(RootPart)
    if not GetRoleOfPlayer then
        return nil, nil
    end

    local ClosestPlayer, ClosestRoot, ClosestDistance
    for _, OtherPlayer in ipairs(PlayersService:GetPlayers()) do
        if OtherPlayer ~= LocalPlayer and GetRoleOfPlayer(OtherPlayer) == "Murderer" then
            local OtherCharacter = OtherPlayer.Character
            local OtherRoot = OtherCharacter and OtherCharacter:FindFirstChild("HumanoidRootPart")
            local OtherHumanoid = OtherCharacter and OtherCharacter:FindFirstChildOfClass("Humanoid")
            if OtherRoot and OtherHumanoid and OtherHumanoid.Health > 0 then
                local Distance = (OtherRoot.Position - RootPart.Position).Magnitude
                if not ClosestDistance or Distance < ClosestDistance then
                    ClosestPlayer, ClosestRoot, ClosestDistance = OtherPlayer, OtherRoot, Distance
                end
            end
        end
    end
    return ClosestRoot, ClosestDistance
end

-- walk the escape ray out and stop short of whatever it hits
local function SolveEscapePosition(RootPart, MurdererRoot)
    local AwayVector = RootPart.Position - MurdererRoot.Position
    AwayVector = Vector3.new(AwayVector.X, 0, AwayVector.Z)
    if AwayVector.Magnitude < 0.5 then
        AwayVector = RootPart.CFrame.LookVector * -1
    end
    AwayVector = AwayVector.Unit

    local RayParams = RaycastParams.new()
    local FilterSet = pcall(function()
        RayParams.FilterType = Enum.RaycastFilterType.Exclude
    end)
    if not FilterSet then
        pcall(function()
            RayParams.FilterType = Enum.RaycastFilterType.Blacklist
        end)
    end

    local Excluded = {}
    if LocalPlayer.Character then
        table.insert(Excluded, LocalPlayer.Character)
    end
    if MurdererRoot.Parent then
        table.insert(Excluded, MurdererRoot.Parent)
    end
    RayParams.FilterDescendantsInstances = Excluded
    RayParams.IgnoreWater = true

    local TravelDistance = ESCAPE_DISTANCE
    local WallHit = nil
    pcall(function()
        WallHit = workspace:Raycast(RootPart.Position, AwayVector * ESCAPE_DISTANCE, RayParams)
    end)
    if WallHit then
        -- stop a few studs short of the wall we would have gone through
        TravelDistance = math.max((WallHit.Position - RootPart.Position).Magnitude - 5, 8)
    end

    return RootPart.Position + (AwayVector * TravelDistance)
end

StopAutoEscapeLoop = function()
    if EscapeConnection then
        EscapeConnection:Disconnect()
        EscapeConnection = nil
    end
end

local function StartAutoEscapeLoop()
    if EscapeConnection then
        return
    end

    EscapeConnection = RunService.Heartbeat:Connect(function()
        if not CoreIsAlive or not AutoEscapeEnabled then
            return
        end
        if os.clock() < NextEscapeTime then
            return
        end

        local Character = LocalPlayer.Character
        local RootPart = Character and Character:FindFirstChild("HumanoidRootPart")
        local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
        if not RootPart or not Humanoid or Humanoid.Health <= 0 then
            return
        end

        local MurdererRoot, Distance = FindNearestMurderer(RootPart)
        if not MurdererRoot or Distance > ESCAPE_TRIGGER_RADIUS then
            return
        end

        NextEscapeTime = os.clock() + ESCAPE_COOLDOWN

        local EscapePosition = SolveEscapePosition(RootPart, MurdererRoot)
        pcall(function()
            Character:PivotTo(CFrame.new(EscapePosition + Vector3.new(0, 3, 0), MurdererRoot.Position))
            RootPart.AssemblyLinearVelocity = Vector3.zero
            RootPart.AssemblyAngularVelocity = Vector3.zero
        end)

        if ShowNotification then
            ShowNotification("AUTO ESCAPE", "Killer was " .. math.floor(Distance) .. " studs out, moved you clear.", Color3.fromRGB(120, 210, 140))
        end
    end)
end

