-- ---- anti fling ----
-- a flinger pushes you through collision, so clamping your own velocity is
-- the wrong fix. the reliable answer: let every other character pass
-- straight through you. your client owns your physics, so once their limbs
-- ghost through there is nothing left to push with. the velocity clamp
-- stays as a backup for launches that still land.
local AntiFlingEnabled = false
local ClearAntiFlingConnections

Builders.AntiFling = function()
local AntiFlingConnection = nil
local NoCollisionParts = setmetatable({}, {__mode = "k"})
local MAX_SAFE_ANGULAR = 40
local MAX_SAFE_LINEAR = 320

local function RestoreOtherPlayerCollisions()
    for Part, OriginalProperties in pairs(NoCollisionParts) do
        if Part and Part.Parent then
            pcall(function()
                Part.CanCollide = OriginalProperties.CanCollide
                Part.Massless = OriginalProperties.Massless
            end)
        end
    end
    table.clear(NoCollisionParts)
end

ClearAntiFlingConnections = function()
    if AntiFlingConnection then
        AntiFlingConnection:Disconnect()
        AntiFlingConnection = nil
    end
    RestoreOtherPlayerCollisions()
end

local function StartAntiFling()
    if AntiFlingConnection then
        return
    end

    AntiFlingConnection = RunService.Stepped:Connect(function()
        if not CoreIsAlive or not AntiFlingEnabled then
            return
        end

        for _, OtherPlayer in ipairs(PlayersService:GetPlayers()) do
            if OtherPlayer ~= LocalPlayer then
                local OtherCharacter = OtherPlayer.Character
                if OtherCharacter then
                    for _, Limb in ipairs(OtherCharacter:GetChildren()) do
                        if Limb:IsA("BasePart") and Limb.CanCollide then
                            if NoCollisionParts[Limb] == nil then
                                NoCollisionParts[Limb] = {
                                    CanCollide = Limb.CanCollide,
                                    Massless = Limb.Massless,
                                }
                            end
                            pcall(function()
                                Limb.CanCollide = false
                                Limb.Massless = true
                            end)
                        end
                    end
                end
            end
        end

        local Character = LocalPlayer.Character
        local RootPart = Character and Character:FindFirstChild("HumanoidRootPart")
        if not RootPart then
            return
        end

        if RootPart.AssemblyAngularVelocity.Magnitude > MAX_SAFE_ANGULAR then
            RootPart.AssemblyAngularVelocity = Vector3.zero
        end

        local Velocity = RootPart.AssemblyLinearVelocity
        if Velocity.Magnitude > MAX_SAFE_LINEAR then
            RootPart.AssemblyLinearVelocity = Vector3.new(0, math.max(Velocity.Y, -160), 0)
        end
    end)
end

