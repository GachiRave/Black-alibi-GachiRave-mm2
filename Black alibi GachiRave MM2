-- KILL ALL, REBUILT FOR SAFETY.
-- The previous version could crash the client outright: a ragdolled or
-- glitched body can carry a NaN or absurdly large CFrame, and handing that
-- straight to PivotTo is what actually brought Roblox down, not the number
-- of players in the sweep. Every destination is checked for finite, sane
-- numbers before it is ever used, the whole routine runs inside pcall, and
-- the running flag always clears, even after an error.
local KillAllRunning = false

local function IsCFrameFinite(TargetCFrame)
    local Position = TargetCFrame.Position
    if Position.X ~= Position.X or Position.Y ~= Position.Y or Position.Z ~= Position.Z then
        return false -- NaN never equals itself
    end
    return math.abs(Position.X) < 100000 and math.abs(Position.Y) < 100000 and math.abs(Position.Z) < 100000
end

local function RunKillAll()
    if KillAllRunning then
        return
    end

    local Knife = GetHeldKnife()
    local Handle = Knife and Knife:FindFirstChild("Handle")
    local TouchFunction = firetouchinterest or (syn and syn.firetouchinterest)

    if not Handle or not TouchFunction then
        ShowNotification("KILL ALL", "You need the knife equipped for this.", Color3.fromRGB(255, 72, 72))
        return
    end

    local Character = LocalPlayer.Character
    local RootPart = Character and Character:FindFirstChild("HumanoidRootPart")
    if not Character or not RootPart or not IsCFrameFinite(RootPart.CFrame) then
        return
    end

    KillAllRunning = true

    task.spawn(function()
        local ReturnPivot = Character:GetPivot()
        local KillCount = 0

        local SweepSucceeded, SweepError = pcall(function()
            for _, OtherPlayer in ipairs(PlayersService:GetPlayers()) do
                if not CoreIsAlive or not KillAllRunning then
                    break
                end

                -- the sweep stops the instant the murderer dies or loses the
                -- knife, continuing past that point served no purpose
                if not Character.Parent or RootPart.Parent ~= Character then
                    break
                end
                local LocalHumanoid = Character:FindFirstChildOfClass("Humanoid")
                if not LocalHumanoid or LocalHumanoid.Health <= 0 or not Handle.Parent then
                    break
                end

                if OtherPlayer ~= LocalPlayer then
                    local OtherCharacter = OtherPlayer.Character
                    local OtherRoot = OtherCharacter and OtherCharacter:FindFirstChild("HumanoidRootPart")
                    local OtherHumanoid = OtherCharacter and OtherCharacter:FindFirstChildOfClass("Humanoid")

                    if OtherRoot and OtherHumanoid and OtherHumanoid.Health > 0 and IsCFrameFinite(OtherRoot.CFrame) then
                        local DestinationCFrame = OtherRoot.CFrame * CFrame.new(0, 0, 2)

                        local StepSucceeded = pcall(function()
                            RootPart.AssemblyLinearVelocity = Vector3.zero
                            RootPart.AssemblyAngularVelocity = Vector3.zero
                            Character:PivotTo(DestinationCFrame)
                            RootPart.AssemblyLinearVelocity = Vector3.zero
                            RootPart.AssemblyAngularVelocity = Vector3.zero
                        end)

                        if StepSucceeded then
                            RunService.Heartbeat:Wait() -- let physics settle for one frame

                            pcall(function()
                                TouchFunction(OtherRoot, Handle, 0)
                                TouchFunction(OtherRoot, Handle, 1)
                            end)

                            KillCount = KillCount + 1
                            task.wait(0.12)
                        end
                    end
                end
            end
        end)

        -- always go home, even if the sweep was cut short or threw an error
        if Character.Parent and RootPart.Parent == Character and IsCFrameFinite(ReturnPivot) then
            pcall(function()
                RootPart.AssemblyLinearVelocity = Vector3.zero
                RootPart.AssemblyAngularVelocity = Vector3.zero
                Character:PivotTo(ReturnPivot)
                RootPart.AssemblyLinearVelocity = Vector3.zero
                RootPart.AssemblyAngularVelocity = Vector3.zero
            end)
        end

        KillAllRunning = false

        if SweepSucceeded then
            ShowNotification("KILL ALL", "Swept " .. KillCount .. " players, back in place.", Color3.fromRGB(255, 72, 72))
        else
            warn("Black Alibi Kill All error: " .. tostring(SweepError))
            ShowNotification("KILL ALL", "Stopped early after an error, back in place.", Color3.fromRGB(235, 180, 110))
        end
    end)
end

