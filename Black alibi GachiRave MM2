-- ============================================================
-- ROLE ENGINE
-- ============================================================

-- Only two booleans and three entry points leave this scope. Everything else
-- is private to the role engine, which keeps the main Luau chunk comfortably
-- below the 200-local compiler limit.
local HighlightEnabled = false
local NameTagsEnabled = false

Builders.RoleEngine = function()

-- roles are taken from MM2's own data, not guessed from a knife showing up.
-- GetPlayerData runs once at boot. After that, only the known role events
-- (Fade, UpdatePlayerData, RoleSelect and RoundEndFade) can trigger updates.
-- There is no render loop, heartbeat scan or repeated descendant walk.
-- Equipment is only a quiet fallback for modified servers.

local RoleByPlayer = {}          -- player -> role key
local RoleFromPacket = {}        -- userid -> role key, filled by source 1
local EspHighlights = {}
local EspNameTags = {}
local JoinedMidRound = {}
local WatchedContainers = {}

local RoundIsLive = false
local ActiveRoleSource = "WAITING"
local RoundSheriffUserId = nil
local GunWasDropped = false
local ScanEveryone

-- 1.0.2: the role reveal banner. AnnounceSelfRole is declared here, before
-- CommitPacketRole is defined below, so the closure it creates can call the
-- real function once it exists further down without a stale reference.
local AnnounceSelfRole
local LastAnnouncedSelfRole = nil

-- role words the game uses, mapped onto our keys
local RoleWordMap = {
    murderer = "Murderer", murder = "Murderer", killer = "Murderer",
    sheriff = "Sheriff", police = "Sheriff",
    hero = "Hero",
    innocent = "Innocent", inno = "Innocent", civilian = "Innocent",
}

local function NormaliseRoleWord(RawValue)
    if typeof(RawValue) ~= "string" then
        return nil
    end
    return RoleWordMap[string.lower(RawValue)]
end

-- turn whatever the packet carried into a real player object
local function ResolvePlayerReference(RawValue)
    if typeof(RawValue) == "Instance" then
        if RawValue:IsA("Player") then
            return RawValue
        end
        if RawValue:IsA("Model") then
            return PlayersService:GetPlayerFromCharacter(RawValue)
        end
    end
    if typeof(RawValue) == "string" then
        return PlayersService:FindFirstChild(RawValue)
    end
    if typeof(RawValue) == "number" then
        return PlayersService:GetPlayerByUserId(RawValue)
    end
    return nil
end

local function CommitPacketRole(TargetPlayer, RoleKey)
    if not TargetPlayer or not RoleKey then
        return
    end
    RoleFromPacket[TargetPlayer.UserId] = RoleKey
    RoundIsLive = true
    ActiveRoleSource = "ROLE PACKET"
    JoinedMidRound[TargetPlayer] = nil
    if RoleKey == "Sheriff" and RoundSheriffUserId == nil then
        RoundSheriffUserId = TargetPlayer.UserId
    end

    -- your own role gets the reveal banner, once per round
    if TargetPlayer == LocalPlayer and RoleKey ~= LastAnnouncedSelfRole then
        LastAnnouncedSelfRole = RoleKey
        if AnnounceSelfRole then
            AnnounceSelfRole(RoleKey)
        end
    end
end

-- MM2 sends a dictionary keyed by player name. This direct parser is both
-- more reliable and much cheaper than listening to every remote in the game.
local function ConsumePlayerData(DataTable, SourceName)
    if typeof(DataTable) ~= "table" then
        return false
    end

    local FoundAnyRole = false
    for PlayerReference, PlayerInfo in pairs(DataTable) do
        local TargetPlayer = ResolvePlayerReference(PlayerReference)
        local RoleKey

        if typeof(PlayerInfo) == "table" then
            RoleKey = NormaliseRoleWord(PlayerInfo.Role or PlayerInfo.role or PlayerInfo.Team)
        else
            RoleKey = NormaliseRoleWord(PlayerInfo)
        end

        if TargetPlayer and RoleKey then
            CommitPacketRole(TargetPlayer, RoleKey)
            FoundAnyRole = true
        end
    end

    if FoundAnyRole then
        ActiveRoleSource = SourceName
    end
    return FoundAnyRole
end

local function QueueRoleRefresh()
    task.defer(function()
        if CoreIsAlive and ScanEveryone then
            ScanEveryone()
        end
    end)
end

local ConnectedRoleRemotes = {}

local function BindKnownRoleRemote(RemoteInstance)
    if ConnectedRoleRemotes[RemoteInstance] or not RemoteInstance:IsA("RemoteEvent") then
        return
    end

    local RemoteName = RemoteInstance.Name
    local IsDataEvent = RemoteName == "Fade" or RemoteName == "UpdatePlayerData"
    local IsLocalRoleEvent = RemoteName == "RoleSelect"
    local IsRoundEndEvent = RemoteName == "RoundEndFade"
    if not IsDataEvent and not IsLocalRoleEvent and not IsRoundEndEvent then
        return
    end

    ConnectedRoleRemotes[RemoteInstance] = true

    if IsDataEvent then
        RemoteInstance.OnClientEvent:Connect(function(DataTable)
            if CoreIsAlive then
                ConsumePlayerData(DataTable, "GAME EVENT")
                QueueRoleRefresh()
            end
        end)
    elseif IsLocalRoleEvent then
        RemoteInstance.OnClientEvent:Connect(function(RoleValue)
            if CoreIsAlive then
                local RoleKey = NormaliseRoleWord(RoleValue)
                if RoleKey then
                    CommitPacketRole(LocalPlayer, RoleKey)
                end
                QueueRoleRefresh()
            end
        end)
    else
        RemoteInstance.OnClientEvent:Connect(function()
            if not CoreIsAlive then
                return
            end
            RoundIsLive = false
            ActiveRoleSource = "WAITING"
            RoundSheriffUserId = nil
            GunWasDropped = false
            LastAnnouncedSelfRole = nil -- next round can announce a fresh role
            table.clear(RoleFromPacket)
            table.clear(JoinedMidRound)
            QueueRoleRefresh()
        end)
    end
end

for _, Descendant in ipairs(ReplicatedStorageService:GetDescendants()) do
    BindKnownRoleRemote(Descendant)
end
ReplicatedStorageService.DescendantAdded:Connect(BindKnownRoleRemote)

-- one initial snapshot, later changes arrive through the events above
local function CollectGameDataRoles()
    local GetPlayerDataRemote = ReplicatedStorageService:FindFirstChild("GetPlayerData", true)
    if not GetPlayerDataRemote or not GetPlayerDataRemote:IsA("RemoteFunction") then
        return false
    end

    local RequestSucceeded, DataTable = pcall(function()
        return GetPlayerDataRemote:InvokeServer()
    end)
    if not RequestSucceeded then
        return false
    end

    return ConsumePlayerData(DataTable, "GET PLAYER DATA")
end

-- ---- source 3: quiet fallback ----
local function EquipmentGuess(TargetPlayer)
    local Backpack = TargetPlayer:FindFirstChildOfClass("Backpack")
    local Character = TargetPlayer.Character

    local function Carries(ToolName)
        if Backpack and Backpack:FindFirstChild(ToolName) then
            return true
        end
        return Character ~= nil and Character:FindFirstChild(ToolName) ~= nil
    end

    if Carries("Knife") then
        return "Murderer"
    end
    if Carries("Gun") or Carries("Revolver") then
        return GunWasDropped and "Hero" or "Sheriff"
    end
    return nil
end

-- HERO TRACKING.
-- the role packet is sent once, at the start of the round, so an innocent
-- who later grabs the dropped gun still reads as "Innocent" forever. the
-- game itself never re-sends anything. so the pickup is tracked separately
-- and layered on top of whatever the packet said:
--   someone holds the gun + they are not the player the round started with
--   as sheriff  ->  Hero.
local function CarriesTool(TargetPlayer, ToolName)
    local Backpack = TargetPlayer:FindFirstChildOfClass("Backpack")
    if Backpack and Backpack:FindFirstChild(ToolName) then
        return true
    end
    local Character = TargetPlayer.Character
    return Character ~= nil and Character:FindFirstChild(ToolName) ~= nil
end

local function HoldsTheGun(TargetPlayer)
    return CarriesTool(TargetPlayer, "Gun") or CarriesTool(TargetPlayer, "Revolver")
end

local function RefreshGunDropState()
    -- must not be sticky: once the drop is gone the flag has to clear again,
    -- a leftover "true" from an earlier round is what mislabelled the sheriff.
    -- uses the same cached locator as the ESP, so it costs nothing.
    GunWasDropped = (LocateDroppedGun ~= nil) and (LocateDroppedGun() ~= nil)
end

-- SHERIFF FIX.
-- the old order tested GunWasDropped before the actual role, so the real
-- sheriff holding their own gun got repainted as Hero. now the game's data
-- always wins: only an Innocent or Unknown can ever be promoted.
local function ApplyHeroOverride(TargetPlayer, BaseRole)
    -- a role the game handed us is final, never argue with it
    if BaseRole == "Murderer" or BaseRole == "Hero" then
        return BaseRole
    end

    if BaseRole == "Sheriff" then
        if RoundSheriffUserId == nil then
            RoundSheriffUserId = TargetPlayer.UserId
        end
        return "Sheriff" -- the sheriff stays the sheriff, gun or no gun
    end

    -- from here on the player is Innocent or Unknown
    if not HoldsTheGun(TargetPlayer) then
        return BaseRole
    end

    -- the round's sheriff can never be demoted by a stale reading
    if RoundSheriffUserId == TargetPlayer.UserId then
        return "Sheriff"
    end

    -- an innocent carrying the gun is the hero
    return "Hero"
end

local function ResolveRoleFor(TargetPlayer)
    local PacketRole = RoleFromPacket[TargetPlayer.UserId]
    if PacketRole then
        return ApplyHeroOverride(TargetPlayer, PacketRole)
    end

    local GuessedRole = EquipmentGuess(TargetPlayer)
    if GuessedRole then
        RoundIsLive = true
        if ActiveRoleSource == "WAITING" then
            ActiveRoleSource = "FALLBACK"
        end
        return ApplyHeroOverride(TargetPlayer, GuessedRole)
    end

    -- joined while the round was already running and nothing was handed out
    if JoinedMidRound[TargetPlayer] then
        return "Unknown"
    end

    if RoundIsLive and TargetPlayer.Character and TargetPlayer.Character:FindFirstChildOfClass("Humanoid") then
        return "Innocent"
    end

    return "Unknown"
end

-- the combat tab asks the role engine who the murderer is
GetRoleOfPlayer = function(TargetPlayer)
    return RoleByPlayer[TargetPlayer]
end

-- ---- visuals ----
local function DestroyEspFor(TargetPlayer)
    local ExistingHighlight = EspHighlights[TargetPlayer]
    if ExistingHighlight then
        ExistingHighlight:Destroy()
        EspHighlights[TargetPlayer] = nil
    end
    local ExistingTag = EspNameTags[TargetPlayer]
