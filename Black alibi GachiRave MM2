local function Slider(Page, Text, Top, Min, Max, Start, OnChange)
    local Cap = Instance.new("TextLabel")
    Cap.Size = UDim2.new(1, -28, 0, 14)
    Cap.Position = UDim2.new(0, 14, 0, Top)
    Cap.BackgroundTransparency = 1
    Cap.Text = Text .. " : " .. tostring(Start)
    Cap.TextColor3 = Color3.fromRGB(196, 196, 206)
    Cap.Font = Enum.Font.Code
    Cap.TextSize = 11
    Cap.TextXAlignment = Enum.TextXAlignment.Left
    Cap.ZIndex = 4
    Cap.Parent = Page

    local Track = Instance.new("Frame")
    Track.Size = UDim2.new(1, -28, 0, 6)
    Track.Position = UDim2.new(0, 14, 0, Top + 20)
    Track.BackgroundColor3 = Color3.fromRGB(40, 40, 47)
    Track.BorderSizePixel = 0
    Track.ZIndex = 4
    Track.Parent = Page
    Corner(Track, 3)

    local Ratio0 = (Start - Min) / (Max - Min)

    local Fill = Instance.new("Frame")
    Fill.Size = UDim2.fromScale(Ratio0, 1)
    Fill.BackgroundColor3 = Palette.Accent
    Fill.BorderSizePixel = 0
    Fill.ZIndex = 4
    Fill.Parent = Track
    Corner(Fill, 3)

    local Knob = Instance.new("Frame")
    Knob.AnchorPoint = Vector2.new(0.5, 0.5)
    Knob.Size = UDim2.fromOffset(13, 13)
    Knob.Position = UDim2.fromScale(Ratio0, 0.5)
    Knob.BackgroundColor3 = Palette.TextMain
    Knob.BorderSizePixel = 0
    Knob.ZIndex = 5
    Knob.Parent = Track
    Corner(Knob, 7)

    local Sensor = Instance.new("TextButton")
    Sensor.AnchorPoint = Vector2.new(0, 0.5)
    Sensor.Size = UDim2.new(1, 0, 0, 26)
    Sensor.Position = UDim2.new(0, 0, 0.5, 0)
    Sensor.BackgroundTransparency = 1
    Sensor.Text = ""
    Sensor.AutoButtonColor = false
    Sensor.ZIndex = 6
    Sensor.Parent = Track

    local Dragging = false

    local function Commit(Ratio)
        Ratio = math.clamp(Ratio, 0, 1)
        local Value = math.floor(Min + ((Max - Min) * Ratio) + 0.5)
        Fill.Size = UDim2.fromScale(Ratio, 1)
        Knob.Position = UDim2.fromScale(Ratio, 0.5)
        Cap.Text = Text .. " : " .. tostring(Value)
        OnChange(Value)
    end

    local function FromPointer(I)
        Commit((I.Position.X - Track.AbsolutePosition.X) / math.max(Track.AbsoluteSize.X, 1))
    end

    Sensor.InputBegan:Connect(function(I)
        if I.UserInputType == Enum.UserInputType.MouseButton1 or I.UserInputType == Enum.UserInputType.Touch then
            Dragging = true
            Animate(Knob, TweenFast, {Size = UDim2.fromOffset(16, 16)})
            FromPointer(I)
        end
    end)

    UserInputService.InputChanged:Connect(function(I)
        if Dragging and (I.UserInputType == Enum.UserInputType.MouseMovement or I.UserInputType == Enum.UserInputType.Touch) then
            FromPointer(I)
        end
    end)

    UserInputService.InputEnded:Connect(function(I)
        if Dragging and (I.UserInputType == Enum.UserInputType.MouseButton1 or I.UserInputType == Enum.UserInputType.Touch) then
            Dragging = false
            Animate(Knob, TweenFast, {Size = UDim2.fromOffset(13, 13)})
        end
    end)

    return function(Value)
        Commit((Value - Min) / (Max - Min))
    end
end

