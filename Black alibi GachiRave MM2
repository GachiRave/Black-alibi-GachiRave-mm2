    Animate(WindowScale, TweenSlow, {Scale = 1})

    local FadeBar = TweenService:Create(MinimizeBar, TweenFast, {GroupTransparency = 1})
    FadeBar:Play()
    FadeBar.Completed:Connect(function()
        if CoreIsAlive and MyToken == ViewToken and not IsMinimized then
            MinimizeBar.Visible = false
        end
    end)
end

