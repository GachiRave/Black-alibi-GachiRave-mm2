local function PaintEspFor(TargetPlayer, RoleKey)
    if TargetPlayer == LocalPlayer then
        return
    end

    local Character = TargetPlayer.Character
    if not Character then
        return
    end

    local RoleTheme = RoleThemes[RoleKey] or RoleThemes.Unknown

    -- chams
    if HighlightEnabled then
        local RoleHighlight = EspHighlights[TargetPlayer]
        if not RoleHighlight or RoleHighlight.Parent ~= Character then
            if RoleHighlight then
                RoleHighlight:Destroy()
            end
            RoleHighlight = Instance.new("Highlight")
            RoleHighlight.Name = "BlackAlibiRoleHighlight"
            RoleHighlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            RoleHighlight.FillTransparency = 0.55
            RoleHighlight.OutlineTransparency = 0
            RoleHighlight.Parent = Character
            EspHighlights[TargetPlayer] = RoleHighlight
        end
        RoleHighlight.FillColor = RoleTheme.Color
        RoleHighlight.OutlineColor = RoleTheme.Color
    elseif EspHighlights[TargetPlayer] then
        EspHighlights[TargetPlayer]:Destroy()
        EspHighlights[TargetPlayer] = nil
    end

    -- name + role tag
    if NameTagsEnabled then
        local AnchorPart = Character:FindFirstChild("Head") or Character:FindFirstChild("HumanoidRootPart")
        if AnchorPart then
            local NameTag = EspNameTags[TargetPlayer]
            if not NameTag or NameTag.Adornee ~= AnchorPart then
                if NameTag then
                    NameTag:Destroy()
                end
                NameTag = Instance.new("BillboardGui")
