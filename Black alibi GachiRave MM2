local SPIN_DEGREES_PER_SECOND = 60

StopSpin = function()
    if SpinConnection then
        SpinConnection:Disconnect()
        SpinConnection = nil
    end
end

local function StartSpin()
    if SpinConnection then
        return
    end

    SpinConnection = RunService.Stepped:Connect(function(_, DeltaTime)
        if not CoreIsAlive or not SpinEnabled then
            return
        end

        local Character = LocalPlayer.Character
        local RootPart = Character and Character:FindFirstChild("HumanoidRootPart")
        if not RootPart then
            return
        end

        RootPart.CFrame = RootPart.CFrame * CFrame.Angles(0, math.rad(SPIN_DEGREES_PER_SECOND * DeltaTime), 0)
    end)
end

Setters.SlowSpin = CreateToggleRow(PagePlayer, "SLOW SPIN", 248, function(NewState)
    SpinEnabled = NewState
    if NewState then
        StartSpin()
    else
        StopSpin()
    end
end)
end
RunBuilder("Spin")

-- ---- fall recovery ----
-- Watches for the void. If you drop below a safe height the last position
-- you stood on solid ground gets you back, instead of respawning far away.
local FallRecoveryEnabled = false
local StopFallRecovery

Builders.FallRecovery = function()
local FallRecoveryConnection = nil
local LastSafeCFrame = nil
local VOID_TRIGGER_HEIGHT = -120
local SAFE_RECORD_HEIGHT = -40

StopFallRecovery = function()
    if FallRecoveryConnection then
        FallRecoveryConnection:Disconnect()
        FallRecoveryConnection = nil
    end
end

local function StartFallRecovery()
    if FallRecoveryConnection then
        return
    end

    FallRecoveryConnection = RunService.Heartbeat:Connect(function()
        if not CoreIsAlive or not FallRecoveryEnabled then
            return
        end

        local Character = LocalPlayer.Character
        local RootPart = Character and Character:FindFirstChild("HumanoidRootPart")
        local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
        if not RootPart or not Humanoid or Humanoid.Health <= 0 then
            return
        end

        if Humanoid.FloorMaterial ~= Enum.Material.Air and RootPart.Position.Y > SAFE_RECORD_HEIGHT then
            LastSafeCFrame = RootPart.CFrame
        end

        if RootPart.Position.Y < VOID_TRIGGER_HEIGHT and LastSafeCFrame then
            pcall(function()
                RootPart.AssemblyLinearVelocity = Vector3.zero
                RootPart.AssemblyAngularVelocity = Vector3.zero
                Character:PivotTo(LastSafeCFrame + Vector3.new(0, 3, 0))
                RootPart.AssemblyLinearVelocity = Vector3.zero
                RootPart.AssemblyAngularVelocity = Vector3.zero
            end)
            if ShowNotification then
                ShowNotification("FALL RECOVERY", "Pulled you back before you hit the void.", Color3.fromRGB(120, 210, 140))
            end
        end
    end)
end

LocalPlayer.CharacterAdded:Connect(function()
    LastSafeCFrame = nil
end)

Setters.FallRecovery = CreateToggleRow(PagePlayer, "FALL RECOVERY", 280, function(NewState)
    FallRecoveryEnabled = NewState
    if NewState then
        StartFallRecovery()
    else
        StopFallRecovery()
    end
end)
end
RunBuilder("FallRecovery")

