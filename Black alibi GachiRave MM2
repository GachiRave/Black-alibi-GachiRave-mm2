-- slider row with a live number box on the right
local function CreateValueSlider(ParentPage, RowLabelText, TopOffset, MinValue, MaxValue, StartValue, OnValueChanged)
    local RowLabel = Instance.new("TextLabel")
    RowLabel.Size = UDim2.new(1, -90, 0, 16)
    RowLabel.Position = UDim2.new(0, 14, 0, TopOffset)
    RowLabel.BackgroundTransparency = 1
    RowLabel.Text = RowLabelText
    RowLabel.TextColor3 = Color3.fromRGB(196, 196, 206)
    RowLabel.Font = Enum.Font.Code
    RowLabel.TextSize = 12
    RowLabel.TextXAlignment = Enum.TextXAlignment.Left
    RowLabel.ZIndex = 4
    RowLabel.Parent = ParentPage

    -- typed input, commits on focus lost or enter.
    -- ZIndex is deliberately above the drag sensor: on a phone the thumb is
    -- wide enough to touch both, and the number box must win that fight.
    local ValueBox = Instance.new("TextBox")
    ValueBox.AnchorPoint = Vector2.new(1, 0)
    ValueBox.Size = UDim2.fromOffset(58, 20)
    ValueBox.Position = UDim2.new(1, -14, 0, TopOffset - 3)
    ValueBox.BackgroundColor3 = Color3.fromRGB(27, 27, 32)
    ValueBox.Text = tostring(StartValue)
    ValueBox.TextColor3 = Palette.TextMain
    ValueBox.Font = Enum.Font.Code
    ValueBox.TextSize = 12
    ValueBox.ClearTextOnFocus = false
    ValueBox.ZIndex = 9
    ValueBox.Parent = ParentPage
    AddCorner(ValueBox, 5)
    local ValueBoxStroke = AddStroke(ValueBox, Palette.Stroke, 0.4)

    local TrackBackground = Instance.new("Frame")
    TrackBackground.Size = UDim2.new(1, -28, 0, 6)
    TrackBackground.Position = UDim2.new(0, 14, 0, TopOffset + 22)
    TrackBackground.BackgroundColor3 = Color3.fromRGB(38, 38, 45)
    TrackBackground.BorderSizePixel = 0
    TrackBackground.ZIndex = 4
    TrackBackground.Parent = ParentPage
    AddCorner(TrackBackground, 3)

    local TrackFill = Instance.new("Frame")
    TrackFill.Size = UDim2.fromScale((StartValue - MinValue) / (MaxValue - MinValue), 1)
    TrackFill.BackgroundColor3 = Palette.Accent
    TrackFill.BorderSizePixel = 0
    TrackFill.ZIndex = 4
    TrackFill.Parent = TrackBackground
    AddCorner(TrackFill, 3)

    local Knob = Instance.new("Frame")
    Knob.AnchorPoint = Vector2.new(0.5, 0.5)
    Knob.Size = UDim2.fromOffset(14, 14)
    Knob.Position = UDim2.fromScale((StartValue - MinValue) / (MaxValue - MinValue), 0.5)
    Knob.BackgroundColor3 = Palette.TextMain
    Knob.BorderSizePixel = 0
    Knob.ZIndex = 5
    Knob.Parent = TrackBackground
    AddCorner(Knob, 7)

    -- the sensor used to be 34px tall and reached up into the number box, so a
    -- tap meant to edit the value dragged the slider instead. it now stays
    -- inside its own row and never crosses into the box above it.
    local Sensor = Instance.new("TextButton")
    Sensor.AnchorPoint = Vector2.new(0, 0.5)
    Sensor.Size = UDim2.new(1, 0, 0, 18)
    Sensor.Position = UDim2.new(0, 0, 0.5, 0)
    Sensor.BackgroundTransparency = 1
    Sensor.Text = ""
    Sensor.AutoButtonColor = false
    Sensor.ZIndex = 6
    Sensor.Parent = TrackBackground

    local CurrentValue = StartValue

    local function CommitValue(NewValue, UpdateBoxText)
        NewValue = math.clamp(math.floor(NewValue + 0.5), MinValue, MaxValue)
        CurrentValue = NewValue

        local Ratio = (NewValue - MinValue) / (MaxValue - MinValue)
        TrackFill.Size = UDim2.fromScale(Ratio, 1)
        Knob.Position = UDim2.fromScale(Ratio, 0.5)

        if UpdateBoxText then
            ValueBox.Text = tostring(NewValue)
        end
        OnValueChanged(NewValue)
    end

    local Dragging = false

    local function UpdateFromPointer(Input)
        local TrackWidth = math.max(TrackBackground.AbsoluteSize.X, 1)
        local Ratio = math.clamp((Input.Position.X - TrackBackground.AbsolutePosition.X) / TrackWidth, 0, 1)
        CommitValue(MinValue + ((MaxValue - MinValue) * Ratio), true)
    end

    Sensor.InputBegan:Connect(function(Input)
        if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
            Dragging = true
            Animate(Knob, TweenFast, {Size = UDim2.fromOffset(17, 17)})
            UpdateFromPointer(Input)
        end
    end)

    UserInputService.InputChanged:Connect(function(Input)
        if not Dragging then
            return
        end
        if Input.UserInputType == Enum.UserInputType.MouseMovement or Input.UserInputType == Enum.UserInputType.Touch then
            UpdateFromPointer(Input)
        end
    end)

    UserInputService.InputEnded:Connect(function(Input)
        if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
            if Dragging then
                Dragging = false
                Animate(Knob, TweenFast, {Size = UDim2.fromOffset(14, 14)})
            end
        end
    end)

    ValueBox.Focused:Connect(function()
        Animate(ValueBoxStroke, TweenFast, {Color = Palette.Accent, Transparency = 0.2})
    end)

    ValueBox.FocusLost:Connect(function()
        Animate(ValueBoxStroke, TweenFast, {Color = Palette.Stroke, Transparency = 0.4})
        local TypedNumber = tonumber(ValueBox.Text)
        if TypedNumber then
            CommitValue(TypedNumber, true)
        else
            ValueBox.Text = tostring(CurrentValue) -- garbage in, old value back
        end
    end)

    return function(NewValue)
        CommitValue(NewValue, true)
    end
end

