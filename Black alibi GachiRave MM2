-- the old offsets used the target's local axes and then the teleport helper
-- added four studs of height on top, which dropped you straight onto them.
-- this builds the spot explicitly: flat look vector, real gap, own height.
local function BuildBehindTargetCFrame(TargetRoot, GapDistance)
    local Facing = TargetRoot.CFrame.LookVector
    local FlatFacing = Vector3.new(Facing.X, 0, Facing.Z)
    if FlatFacing.Magnitude < 0.05 then
        FlatFacing = Vector3.new(0, 0, 1)
    end
    FlatFacing = FlatFacing.Unit

    -- stand behind their back, at their height, looking at them
    local StandPosition = TargetRoot.Position - (FlatFacing * GapDistance)
    return CFrame.new(StandPosition, Vector3.new(TargetRoot.Position.X, StandPosition.Y, TargetRoot.Position.Z))
end

