-- the aim only makes sense with the revolver actually equipped: a gun sitting
-- in the backpack is not drawn, so the camera must stay free until you hold it
local function GunIsEquipped()
    local Character = LocalPlayer.Character
    if not Character then
        return false
    end
    for _, ToolName in ipairs({"Gun", "Revolver"}) do
        local HeldTool = Character:FindFirstChild(ToolName)
        if HeldTool and HeldTool:IsA("Tool") then
            return true
        end
    end
    return false
end

local function FindMurdererTarget()
    if not GetRoleOfPlayer then
        return nil
    end

    for _, OtherPlayer in ipairs(PlayersService:GetPlayers()) do
        if OtherPlayer ~= LocalPlayer and GetRoleOfPlayer(OtherPlayer) == "Murderer" then
            local OtherCharacter = OtherPlayer.Character
            local TargetRoot = OtherCharacter and OtherCharacter:FindFirstChild("HumanoidRootPart")
            local TargetPart = OtherCharacter and (
                OtherCharacter:FindFirstChild("UpperTorso")
                or OtherCharacter:FindFirstChild("Torso")
                or TargetRoot
            )
            local TargetHumanoid = OtherCharacter and OtherCharacter:FindFirstChildOfClass("Humanoid")
            if TargetPart and TargetRoot and TargetHumanoid and TargetHumanoid.Health > 0 then
                return OtherPlayer, TargetPart, TargetRoot, TargetHumanoid
            end
        end
    end
    return nil
end

-- AUTO FIRE ON LOCK.
-- Reuses the tool's own Activate call, so the shot travels wherever the
-- aimbot is currently pointing the camera, exactly like a manual tap would.
local NextAutoFireTime = 0
local AUTO_FIRE_COOLDOWN = 0.5
local AUTO_FIRE_MAX_DISTANCE = 130

local function TryAutoFire(TargetHumanoid, Distance)
    if not AutoFireEnabled or Distance > AUTO_FIRE_MAX_DISTANCE then
        return
    end
    if os.clock() < NextAutoFireTime then
        return
    end

    local Character = LocalPlayer.Character
    local FiringTool = Character and (Character:FindFirstChild("Gun") or Character:FindFirstChild("Revolver"))
    if not FiringTool or not FiringTool:IsA("Tool") then
        return
    end

    local ActivationSucceeded = pcall(function()
        FiringTool:Activate()
    end)

    if ActivationSucceeded then
        NextAutoFireTime = os.clock() + AUTO_FIRE_COOLDOWN
    end
end

-- PREDICTION AIMBOT.
-- MM2 shots are fast, so huge generic projectile prediction makes jumpers pull
-- the camera into the ceiling. Horizontal and vertical motion are deliberately
-- solved separately: horizontal lead is dynamic, vertical lead is short and
-- capped. The velocity filter removes one-frame replication spikes. The
-- response curve is now adaptive: a fast, decisive snap up close and a
-- gentler approach at range, which stops the old fixed smoothing from
-- overshooting on long sightlines.
local AIM_RENDER_STEP_NAME = "BlackAlibiPredictionAimbot"
local AIM_RESPONSE_MIN = 16
local AIM_RESPONSE_MAX = 44
local AIM_RESPONSE_FALLOFF_DISTANCE = 90
local ASSUMED_SHOT_SPEED = 720
local MAX_LEAD_TIME = 0.18
local MAX_HORIZONTAL_LEAD = 6
local MAX_VERTICAL_LEAD = 1
local SmoothedVelocityByPlayer = setmetatable({}, {__mode = "k"})
local CachedNetworkLatencySeconds = 0.04
local LastNetworkLatencyUpdate = 0

local function ComputeAimResponse(Distance)
    local Ratio = math.clamp(Distance / AIM_RESPONSE_FALLOFF_DISTANCE, 0, 1)
    return AIM_RESPONSE_MAX - ((AIM_RESPONSE_MAX - AIM_RESPONSE_MIN) * Ratio)
end

local function GetNetworkLatencySeconds()
    local CurrentTime = os.clock()
    if CurrentTime - LastNetworkLatencyUpdate < 1 then
        return CachedNetworkLatencySeconds
    end
    LastNetworkLatencyUpdate = CurrentTime

    pcall(function()
        local StatsService = game:GetService("Stats")
        local NetworkStats = StatsService:FindFirstChild("Network")
        local ServerStats = NetworkStats and NetworkStats:FindFirstChild("ServerStatsItem")
        local DataPing = ServerStats and ServerStats:FindFirstChild("Data Ping")
        if DataPing and DataPing.GetValue then
            CachedNetworkLatencySeconds = math.clamp(DataPing:GetValue() / 1000, 0, 0.25)
        end
    end)

    return CachedNetworkLatencySeconds
end

local function ClampHorizontalVector(VectorValue, MaximumLength)
    local HorizontalVector = Vector3.new(VectorValue.X, 0, VectorValue.Z)
    local HorizontalLength = HorizontalVector.Magnitude
    if HorizontalLength > MaximumLength and HorizontalLength > 0 then
        return HorizontalVector.Unit * MaximumLength
    end
    return HorizontalVector
end

local function GetPredictedBodyPosition(TargetPlayer, TargetPart, TargetRoot, TargetHumanoid, DeltaTime)
    local RawVelocity = TargetRoot.AssemblyLinearVelocity
    local PreviousVelocity = SmoothedVelocityByPlayer[TargetPlayer] or RawVelocity

    -- Stable across frame rates: roughly the same filter at 30, 60 and 120 FPS.
    local VelocityBlend = 1 - math.exp(-10 * math.clamp(DeltaTime, 0, 0.1))
    local SmoothedVelocity = PreviousVelocity:Lerp(RawVelocity, VelocityBlend)
    SmoothedVelocityByPlayer[TargetPlayer] = SmoothedVelocity

    local ActiveCamera = workspace.CurrentCamera
    local CameraPosition = ActiveCamera and ActiveCamera.CFrame.Position or TargetPart.Position
    local Distance = (TargetPart.Position - CameraPosition).Magnitude

    -- Half the measured round-trip ping approximates one-way replication delay.
    local LeadTime = math.clamp(
        (Distance / ASSUMED_SHOT_SPEED) + (GetNetworkLatencySeconds() * 0.5),
        0.015,
        MAX_LEAD_TIME
    )

    local HorizontalVelocity = ClampHorizontalVector(SmoothedVelocity, 32)
    local HorizontalLead = ClampHorizontalVector(HorizontalVelocity * LeadTime, MAX_HORIZONTAL_LEAD)

    local VerticalLead = 0
    if TargetHumanoid.FloorMaterial == Enum.Material.Air then
        -- Only a small fraction of Y velocity is useful for MM2. Capping this
        -- is what prevents the classic "aim five metres above a jumper" bug.
        local VerticalTime = math.min(LeadTime, 0.09)
        VerticalLead = math.clamp(SmoothedVelocity.Y * VerticalTime, -MAX_VERTICAL_LEAD, MAX_VERTICAL_LEAD)
    end

    return TargetPart.Position + HorizontalLead + Vector3.new(0, VerticalLead, 0), Distance
end

StopAimbot = function()
    AimbotEnabled = false
    RunService:UnbindFromRenderStep(AIM_RENDER_STEP_NAME)
end

local function StartAimbot()
    RunService:UnbindFromRenderStep(AIM_RENDER_STEP_NAME)

    RunService:BindToRenderStep(AIM_RENDER_STEP_NAME, Enum.RenderPriority.Camera.Value + 1, function(DeltaTime)
        if not CoreIsAlive or not AimbotEnabled or not GunIsEquipped() then
            return
        end

        local ActiveCamera = workspace.CurrentCamera
        if not ActiveCamera then
            return
        end

        local TargetPlayer, TargetPart, TargetRoot, TargetHumanoid = FindMurdererTarget()
        if not TargetPlayer then
            return
        end

        if AimWallCheckEnabled and not TargetIsVisible(ActiveCamera.CFrame.Position, TargetPart) then
            return
        end

        local PredictedPosition, Distance = GetPredictedBodyPosition(
            TargetPlayer,
            TargetPart,
            TargetRoot,
            TargetHumanoid,
            DeltaTime
        )

        local DesiredCameraCFrame = CFrame.new(ActiveCamera.CFrame.Position, PredictedPosition)
        local AimAlpha = 1 - math.exp(-ComputeAimResponse(Distance) * math.clamp(DeltaTime, 0, 0.1))
        ActiveCamera.CFrame = ActiveCamera.CFrame:Lerp(DesiredCameraCFrame, AimAlpha)

        TryAutoFire(TargetHumanoid, Distance)
    end)
end

