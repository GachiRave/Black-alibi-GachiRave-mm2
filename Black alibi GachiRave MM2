        return nil
    end
    return RoleWordMap[string.lower(RawValue)]
end

-- turn whatever the packet carried into a real player object
local function ResolvePlayerReference(RawValue)
    if typeof(RawValue) == "Instance" then
        if RawValue:IsA("Player") then
            return RawValue
        end
        if RawValue:IsA("Model") then
            return PlayersService:GetPlayerFromCharacter(RawValue)
        end
    end
    if typeof(RawValue) == "string" then
        return PlayersService:FindFirstChild(RawValue)
    end
    if typeof(RawValue) == "number" then
        return PlayersService:GetPlayerByUserId(RawValue)
    end
    return nil
end

-- one entry of the data table can look like a string, a word field, or a
-- pile of booleans: {Murderer = true}. read all three shapes.
local function RoleFromInfoEntry(PlayerInfo)
    if typeof(PlayerInfo) == "string" then
        return NormaliseRoleWord(PlayerInfo)
    end
    if typeof(PlayerInfo) ~= "table" then
        return nil
    end

    local WordRole = NormaliseRoleWord(PlayerInfo.Role or PlayerInfo.role or PlayerInfo.Team or PlayerInfo.PlayerRole)
    if WordRole then
        return WordRole
    end

    if PlayerInfo.Murderer == true or PlayerInfo.IsMurderer == true then
        return "Murderer"
    end
    if PlayerInfo.Sheriff == true or PlayerInfo.IsSheriff == true then
        return "Sheriff"
    end
    if PlayerInfo.Hero == true or PlayerInfo.IsHero == true then
        return "Hero"
    end
    if PlayerInfo.Innocent == true or PlayerInfo.IsInnocent == true
        or PlayerInfo.Dead == false or PlayerInfo.Alive == true then
        return "Innocent"
    end
    return nil
end

local function CommitPacketRole(TargetPlayer, RoleKey)
    if not TargetPlayer or not RoleKey then
        return
    end
    RoleFromPacket[TargetPlayer.UserId] = RoleKey
    RoundIsLive = true
    ActiveRoleSource = "ROLE PACKET"
    JoinedMidRound[TargetPlayer] = nil
    if RoleKey == "Sheriff" and RoundSheriffUserId == nil then
        RoundSheriffUserId = TargetPlayer.UserId
    end

    -- the readout only moves if the toggle asked for it
    if TargetPlayer == LocalPlayer and RefreshMyRoleHud then
        RefreshMyRoleHud()
    end
end

local function ConsumePlayerData(DataTable, SourceName)
    if typeof(DataTable) ~= "table" then
        return false
    end

    local FoundAnyRole = false
    for PlayerReference, PlayerInfo in pairs(DataTable) do
        local TargetPlayer = ResolvePlayerReference(PlayerReference)
        local RoleKey = RoleFromInfoEntry(PlayerInfo)

        if TargetPlayer and RoleKey then
            CommitPacketRole(TargetPlayer, RoleKey)
            FoundAnyRole = true
        end
    end

    if FoundAnyRole then
        ActiveRoleSource = SourceName
    end
    return FoundAnyRole
end

local function QueueRoleRefresh()
    task.defer(function()
        if CoreIsAlive and ScanEveryone then
            ScanEveryone()
        end
    end)
end

-- GetPlayerData arrives a moment after the round-start event, so a single
-- invoke can come back empty. retry a few times with a pause, give up quietly.
local DataRetryRunning = false

local function CollectGameDataRoles()
    local GetPlayerDataRemote = ReplicatedStorageService:FindFirstChild("GetPlayerData", true)
    if not GetPlayerDataRemote or not GetPlayerDataRemote:IsA("RemoteFunction") then
        return false
    end

    local RequestSucceeded, DataTable = pcall(function()
        return GetPlayerDataRemote:InvokeServer()
    end)
    if not RequestSucceeded then
        return false
    end

    return ConsumePlayerData(DataTable, "GET PLAYER DATA")
end

local function ScheduleDataRetries()
    if DataRetryRunning then
        return
    end
    DataRetryRunning = true

    task.spawn(function()
        for _ = 1, 8 do
            if not CoreIsAlive then
                break
            end
            if CollectGameDataRoles() then
                QueueRoleRefresh()
                break
            end
            task.wait(1.5)
        end
        DataRetryRunning = false
    end)
end

local ConnectedRoleRemotes = {}

local function BindKnownRoleRemote(RemoteInstance)
    if ConnectedRoleRemotes[RemoteInstance] or not RemoteInstance:IsA("RemoteEvent") then
        return
    end

    local RemoteName = RemoteInstance.Name
    local IsDataEvent = RemoteName == "Fade" or RemoteName == "UpdatePlayerData"
    local IsLocalRoleEvent = RemoteName == "RoleSelect"
    local IsRoundEndEvent = RemoteName == "RoundEndFade"
    if not IsDataEvent and not IsLocalRoleEvent and not IsRoundEndEvent then
        return
    end

    ConnectedRoleRemotes[RemoteInstance] = true

    if IsDataEvent then
        RemoteInstance.OnClientEvent:Connect(function(DataTable)
            if not CoreIsAlive then
                return
            end
            local GotRoles = ConsumePlayerData(DataTable, "GAME EVENT")
            QueueRoleRefresh()
            -- Fade fires at round start; the full table often lands late
            if not GotRoles then
                ScheduleDataRetries()
            end
        end)
    elseif IsLocalRoleEvent then
        RemoteInstance.OnClientEvent:Connect(function(RoleValue)
            if CoreIsAlive then
                local RoleKey = NormaliseRoleWord(RoleValue)
                if RoleKey then
                    CommitPacketRole(LocalPlayer, RoleKey)
                end
                QueueRoleRefresh()
            end
        end)
    else
        RemoteInstance.OnClientEvent:Connect(function()
            if not CoreIsAlive then
                return
            end
            RoundIsLive = false
            ActiveRoleSource = "WAITING"
            RoundSheriffUserId = nil
            GunWasDropped = false
            table.clear(RoleFromPacket)
            table.clear(JoinedMidRound)
            QueueRoleRefresh()
        end)
    end
end

for _, Descendant in ipairs(ReplicatedStorageService:GetDescendants()) do
    BindKnownRoleRemote(Descendant)
end
ReplicatedStorageService.DescendantAdded:Connect(BindKnownRoleRemote)

-- ---- equipment fallback ----
local function EquipmentGuess(TargetPlayer)
    local Backpack = TargetPlayer:FindFirstChildOfClass("Backpack")
    local Character = TargetPlayer.Character

    local function Carries(ToolName)
        if Backpack and Backpack:FindFirstChild(ToolName) then
            return true
        end
        return Character ~= nil and Character:FindFirstChild(ToolName) ~= nil
    end

    if Carries("Knife") then
        return "Murderer"
    end
    if Carries("Gun") or Carries("Revolver") then
        return GunWasDropped and "Hero" or "Sheriff"
    end
    return nil
end

-- hero tracking: the packet is sent once at round start, so an innocent who
-- grabs the dropped gun would read Innocent forever. the pickup is layered
-- on top: someone not-the-sheriff holding the gun is the hero
local function CarriesTool(TargetPlayer, ToolName)
    local Backpack = TargetPlayer:FindFirstChildOfClass("Backpack")
    if Backpack and Backpack:FindFirstChild(ToolName) then
        return true
    end
    local Character = TargetPlayer.Character
    return Character ~= nil and Character:FindFirstChild(ToolName) ~= nil
end

local function HoldsTheGun(TargetPlayer)
    return CarriesTool(TargetPlayer, "Gun") or CarriesTool(TargetPlayer, "Revolver")
end

local function RefreshGunDropState()
    -- must not stay sticky: once the drop is gone the flag clears again
    GunWasDropped = (LocateDroppedGun ~= nil) and (LocateDroppedGun() ~= nil)
end

-- the game's data always wins: only an Innocent or Unknown can be promoted,
-- the round's real sheriff never gets repainted as a hero
local function ApplyHeroOverride(TargetPlayer, BaseRole)
    if BaseRole == "Murderer" or BaseRole == "Hero" then
        return BaseRole
    end

    if BaseRole == "Sheriff" then
        if RoundSheriffUserId == nil then
            RoundSheriffUserId = TargetPlayer.UserId
        end
        return "Sheriff"
    end

    if not HoldsTheGun(TargetPlayer) then
        return BaseRole
    end

    if RoundSheriffUserId == TargetPlayer.UserId then
        return "Sheriff"
    end

    return "Hero"
end

local function ResolveRoleFor(TargetPlayer)
    local PacketRole = RoleFromPacket[TargetPlayer.UserId]
    if PacketRole then
        return ApplyHeroOverride(TargetPlayer, PacketRole)
    end

    local GuessedRole = EquipmentGuess(TargetPlayer)
    if GuessedRole then
        RoundIsLive = true
        if ActiveRoleSource == "WAITING" then
            ActiveRoleSource = "FALLBACK"
        end
        return ApplyHeroOverride(TargetPlayer, GuessedRole)
    end

    if JoinedMidRound[TargetPlayer] then
        return "Unknown"
    end

    if RoundIsLive and TargetPlayer.Character and TargetPlayer.Character:FindFirstChildOfClass("Humanoid") then
        return "Innocent"
    end

    return "Unknown"
end

GetRoleOfPlayer = function(TargetPlayer)
    return RoleByPlayer[TargetPlayer]
end

