-- Saved through the executor file API when it exists. Without it the configs
-- still work for the current session, they just do not survive a relaunch.
local CONFIG_FOLDER = "BlackAlibiMM2"
local HttpServiceForJson = game:GetService("HttpService")

local FileWrite = writefile
local FileRead = readfile
local FileDelete = delfile
local FileExists = isfile
local FolderExists = isfolder
local FolderCreate = makefolder
local FolderList = listfiles

local FileApiAvailable = (FileWrite and FileRead and FileExists) and true or false
