Builders.Spin = function()
local SpinConnection = nil
local SPIN_DEGREES_PER_SECOND = 60

StopSpin = function()
    if SpinConnection then
        SpinConnection:Disconnect()
        SpinConnection = nil
    end
end

local function StartSpin()
    if SpinConnection then
        return
    end

    SpinConnection = RunService.Stepped:Connect(function(_, DeltaTime)
        if not CoreIsAlive or not SpinEnabled then
            return
        end

        local Character = LocalPlayer.Character
        local RootPart = Character and Character:FindFirstChild("HumanoidRootPart")
        if not RootPart then
            return
        end

        RootPart.CFrame = RootPart.CFrame * CFrame.Angles(0, math.rad(SPIN_DEGREES_PER_SECOND * DeltaTime), 0)
    end)
end

