local COIN_SCAN_RADIUS = 220

local function IsCoinPart(CandidateInstance)
    if not CandidateInstance:IsA("BasePart") then
        return false
    end
    local LowerName = string.lower(CandidateInstance.Name)
    return string.find(LowerName, "coin", 1, true) ~= nil
