local TweenSlow = TweenInfo.new(0.4, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
local TweenFast = TweenInfo.new(0.17, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local TweenSpring = TweenInfo.new(0.24, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

local Alive = true

local function Animate(Target, Preset, Props)
    if not Alive or not Target then return nil end
    local M = TweenService:Create(Target, Preset, Props)
    M:Play()
    return M
end

local function Corner(Target, Radius)
    local C = Instance.new("UICorner")
    C.CornerRadius = UDim.new(0, Radius)
    C.Parent = Target
    return C
end

local function Stroke(Target, Col, Trans)
    local S = Instance.new("UIStroke")
    S.Color = Col
    S.Transparency = Trans
    S.Thickness = 1
    S.Parent = Target
    return S
end

local function Press(Button, Scale)
    local S = Instance.new("UIScale")
    S.Parent = Button
    Button.InputBegan:Connect(function(I)
        if I.UserInputType == Enum.UserInputType.MouseButton1 or I.UserInputType == Enum.UserInputType.Touch then
            Animate(S, TweenFast, {Scale = Scale})
        end
    end)
    Button.InputEnded:Connect(function(I)
        if I.UserInputType == Enum.UserInputType.MouseButton1 or I.UserInputType == Enum.UserInputType.Touch then
            Animate(S, TweenSpring, {Scale = 1})
        end
    end)
    return S
end

-- grab point measured once, four edges clamped
local function Draggable(Frame, Handle)
    Handle = Handle or Frame
    local MARGIN = 6
    local Dragging, Active, Grab = false, nil, nil

    local function V2(I)
        return Vector2.new(I.Position.X, I.Position.Y)
    end

    local function Place(TopLeft)
        local Cam = workspace.CurrentCamera
        local View = Cam and Cam.ViewportSize or Vector2.new(1280, 720)
        local Size = Frame.AbsoluteSize
        if Size.X < 1 or Size.Y < 1 then return end
        local A = Frame.AnchorPoint
        local X = math.clamp(TopLeft.X, MARGIN, math.max(View.X - Size.X - MARGIN, MARGIN))
        local Y = math.clamp(TopLeft.Y, MARGIN, math.max(View.Y - Size.Y - MARGIN, MARGIN))
        Frame.Position = UDim2.fromOffset(X + (Size.X * A.X), Y + (Size.Y * A.Y))
    end

    Handle.InputBegan:Connect(function(I)
        if I.UserInputType ~= Enum.UserInputType.MouseButton1 and I.UserInputType ~= Enum.UserInputType.Touch then
            return
        end
        Dragging, Active = true, I
        Grab = V2(I) - Frame.AbsolutePosition
        I.Changed:Connect(function()
            if I.UserInputState == Enum.UserInputState.End then
                Dragging, Active = false, nil
            end
        end)
    end)

    UserInputService.InputChanged:Connect(function(I)
        if not Dragging or not Grab then return end
        local Mouse = I.UserInputType == Enum.UserInputType.MouseMovement
        local Touch = I.UserInputType == Enum.UserInputType.Touch and I == Active
        if not Mouse and not Touch then return end
        Place(V2(I) - Grab)
    end)

    local Cam = workspace.CurrentCamera
    if Cam then
        Cam:GetPropertyChangedSignal("ViewportSize"):Connect(function()
            if Alive and not Dragging and Frame.Parent then
                Place(Frame.AbsolutePosition)
            end
        end)
    end
end

