local RadarConnection = nil

local function FindMurdererRootForRadar()
    if not GetRoleOfPlayer then
        return nil
    end
    for _, OtherPlayer in ipairs(PlayersService:GetPlayers()) do
        if OtherPlayer ~= LocalPlayer and GetRoleOfPlayer(OtherPlayer) == "Murderer" then
            local OtherCharacter = OtherPlayer.Character
            local OtherRoot = OtherCharacter and OtherCharacter:FindFirstChild("HumanoidRootPart")
            if OtherRoot then
                return OtherRoot
            end
        end
    end
    return nil
end

StopMurdererRadar = function()
    if RadarConnection then
        RadarConnection:Disconnect()
        RadarConnection = nil
    end
    RadarHolder.Visible = false
end

local function StartRadarLoop()
    if RadarConnection then
        return
    end
    RadarHolder.Visible = true

    RadarConnection = RunService.Heartbeat:Connect(function()
        if not CoreIsAlive or not MurdererRadarEnabled then
            return
        end

        local Character = LocalPlayer.Character
        local RootPart = Character and Character:FindFirstChild("HumanoidRootPart")
        local ActiveCamera = workspace.CurrentCamera
        local MurdererRoot = FindMurdererRootForRadar()

        if not MurdererRoot or not RootPart or not ActiveCamera then
            RadarArrow.Rotation = 0
            RadarDistanceLabel.Text = "MURDERER · UNKNOWN"
            Animate(RadarStroke, TweenFast, {Transparency = 0.5})
            return
        end

        local ToTarget = MurdererRoot.Position - RootPart.Position
        local Distance = ToTarget.Magnitude
        local CameraForward = ActiveCamera.CFrame.LookVector
        local FlatToTarget = Vector3.new(ToTarget.X, 0, ToTarget.Z)
        local FlatForward = Vector3.new(CameraForward.X, 0, CameraForward.Z)

        if FlatToTarget.Magnitude > 0.01 and FlatForward.Magnitude > 0.01 then
            local Cross = (FlatForward.X * FlatToTarget.Z) - (FlatForward.Z * FlatToTarget.X)
            local Dot = (FlatForward.X * FlatToTarget.X) + (FlatForward.Z * FlatToTarget.Z)
            RadarArrow.Rotation = math.deg(math.atan2(Cross, Dot))
        end

        RadarDistanceLabel.Text = "MURDERER · " .. math.floor(Distance) .. " STUDS"
        Animate(RadarStroke, TweenFast, {Transparency = 0.15})
    end)
end

