-- KILL ALL, REBUILT FOR SAFETY.
-- The previous version teleported and touched every player back to back on
-- raw task.wait timers. On a full lobby the burst of PivotTo calls and
-- firetouchinterest calls landed faster than the client could actually
-- replicate them, and that overload is what took the whole game down. This
-- version steps once per rendered frame, re-validates the knife and every
-- target immediately before each touch, and never reuses a reference that
-- might already be gone.
local KillAllRunning = false

local function RunKillAll()
    if KillAllRunning then
        return
    end

    local Knife = GetHeldKnife()
    local Handle = Knife and Knife:FindFirstChild("Handle")
    local TouchFunction = firetouchinterest or (syn and syn.firetouchinterest)

    if not Handle or not TouchFunction then
        if ShowNotification then
            ShowNotification("KILL ALL", "You need the knife equipped for this.", Color3.fromRGB(255, 72, 72))
        end
        return
    end

    local Character = LocalPlayer.Character
    local RootPart = Character and Character:FindFirstChild("HumanoidRootPart")
    if not Character or not RootPart then
        return
    end

    KillAllRunning = true

    task.spawn(function()
        -- a fixed roster taken up front, a player leaving mid sweep can no
        -- longer shift indices under the loop or hand it a torn reference
        local Roster = {}
        for _, OtherPlayer in ipairs(PlayersService:GetPlayers()) do
            if OtherPlayer ~= LocalPlayer then
                table.insert(Roster, OtherPlayer)
            end
        end

        local ReturnPivot = Character:GetPivot()
        local KillCount = 0

        local SweepSucceeded, SweepError = pcall(function()
            for _, OtherPlayer in ipairs(Roster) do
                if not CoreIsAlive or not KillAllRunning then
                    break
                end

                -- fetched fresh every loop: the knife can vanish mid sweep if
                -- the round ends, and an old Handle reference is exactly what
                -- used to hand firetouchinterest garbage to work with
                local CurrentKnife = GetHeldKnife()
                local CurrentHandle = CurrentKnife and CurrentKnife:FindFirstChild("Handle")
                if not CurrentHandle or not CurrentHandle.Parent then
                    break
                end

                if not Character.Parent or not RootPart.Parent then
                    break
                end

                local OtherCharacter = OtherPlayer.Character
                local OtherRoot = OtherCharacter and OtherCharacter:FindFirstChild("HumanoidRootPart")
                local OtherHumanoid = OtherCharacter and OtherCharacter:FindFirstChildOfClass("Humanoid")

                if OtherRoot and OtherHumanoid and OtherHumanoid.Health > 0 then
                    local MoveSucceeded = pcall(function()
                        Character:PivotTo(OtherRoot.CFrame * CFrame.new(0, 0, 2))
                        RootPart.AssemblyLinearVelocity = Vector3.zero
                        RootPart.AssemblyAngularVelocity = Vector3.zero
                    end)

                    -- frame synced, never faster than the client can replicate
                    RunService.Heartbeat:Wait()

                    if MoveSucceeded and OtherRoot.Parent then
                        pcall(function()
                            TouchFunction(OtherRoot, CurrentHandle, 0)
                        end)
                        RunService.Heartbeat:Wait()
                        pcall(function()
                            TouchFunction(OtherRoot, CurrentHandle, 1)
                        end)
                        KillCount = KillCount + 1
                    end

                    RunService.Heartbeat:Wait()
                end
            end
        end)

        -- always go home, even if the sweep threw or was cancelled
        if Character.Parent and RootPart.Parent == Character then
            pcall(function()
                Character:PivotTo(ReturnPivot)
                RootPart.AssemblyLinearVelocity = Vector3.zero
                RootPart.AssemblyAngularVelocity = Vector3.zero
            end)
        end

        KillAllRunning = false

        if not ShowNotification then
            return
        end

        if not SweepSucceeded then
            warn("[Black Alibi] Kill All stopped early: " .. tostring(SweepError))
            ShowNotification("KILL ALL", "Stopped early, back in place.", Color3.fromRGB(235, 180, 110))
        else
            ShowNotification("KILL ALL", "Swept " .. KillCount .. " players, back in place.", Color3.fromRGB(255, 72, 72))
        end
    end)
end

