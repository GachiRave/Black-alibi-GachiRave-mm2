            if CoreIsAlive and not BackdropShown then
                DimLayer.Visible = false
            end
        end)
    end
end

-- one drag handler for mouse and touch
local function MakeDraggable(TargetFrame)
    local Dragging = false
    local PointerOrigin, FrameOrigin

    TargetFrame.InputBegan:Connect(function(Input)
        if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
            Dragging = true
            PointerOrigin = Input.Position
            FrameOrigin = TargetFrame.Position
            Input.Changed:Connect(function()
                if Input.UserInputState == Enum.UserInputState.End then
                    Dragging = false
                end
            end)
        end
    end)

    UserInputService.InputChanged:Connect(function(Input)
        if not Dragging then
            return
        end
        if Input.UserInputType ~= Enum.UserInputType.MouseMovement and Input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end
        local Delta = Input.Position - PointerOrigin
        TargetFrame.Position = UDim2.new(
            FrameOrigin.X.Scale, FrameOrigin.X.Offset + Delta.X,
            FrameOrigin.Y.Scale, FrameOrigin.Y.Offset + Delta.Y
        )
    end)
end

