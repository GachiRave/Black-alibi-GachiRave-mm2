local function MinimizeMenu()
    if IsMinimized then
        return
    end
    IsMinimized = true
    ViewToken = ViewToken + 1
    local MyToken = ViewToken

    SetBackdrop(false)
    Animate(WindowScale, TweenFast, {Scale = 0.96})

    local FadeWindow = TweenService:Create(MainWindow, TweenFast, {GroupTransparency = 1})
    FadeWindow:Play()
    FadeWindow.Completed:Connect(function()
        if CoreIsAlive and MyToken == ViewToken and IsMinimized then
            MainWindow.Visible = false
        end
    end)

    MinimizeBar.Visible = true
    Animate(MinimizeBar, TweenSlow, {GroupTransparency = 0})
end

