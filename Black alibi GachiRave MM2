    end

    local BuilderSucceeded, BuilderError = pcall(BuilderFunction)
    if not BuilderSucceeded then
        warn("[Black Alibi] " .. tostring(BuilderName) .. " failed: " .. tostring(BuilderError))
        return false
    end
    return true
end

