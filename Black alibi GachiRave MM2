-- the knife only registers on a real touch, so the aura fires the touch itself
local KillAuraConnection = nil

local function GetHeldKnife()
    local Character = LocalPlayer.Character
    if Character then
        local HeldKnife = Character:FindFirstChild("Knife")
        if HeldKnife then
            return HeldKnife
        end
    end
    local Backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    return Backpack and Backpack:FindFirstChild("Knife")
end

-- legit mode: refuse anything the player could not physically reach
-- one line of sight test shared by the kill aura, the sheriff aim and the
-- knife throw button. all three exclude both characters, so only real map
-- geometry can ever block a shot.
local function TargetIsVisible(OriginPosition, TargetPart)
    local RayParams = RaycastParams.new()
    -- older mobile executors still ship the Blacklist enum name
    RayParams.FilterType = Enum.RaycastFilterType.Exclude or Enum.RaycastFilterType.Blacklist

    local ExcludedInstances = {}
    if LocalPlayer.Character then
        table.insert(ExcludedInstances, LocalPlayer.Character)
    end
    if TargetPart.Parent then
        table.insert(ExcludedInstances, TargetPart.Parent)
    end
    RayParams.FilterDescendantsInstances = ExcludedInstances
    RayParams.IgnoreWater = true

    -- A single ray to the centre used to slip past thin walls and one sided
    -- geometry, which is why the aim still locked through cover sometimes.
    -- Three samples down the body have to be clear before a target counts.
    local SamplePoints = {
        TargetPart.Position + Vector3.new(0, 1.4, 0),
        TargetPart.Position,
        TargetPart.Position - Vector3.new(0, 1.4, 0),
    }

    for _, SamplePosition in ipairs(SamplePoints) do
        local Direction = SamplePosition - OriginPosition
        if Direction.Magnitude >= 0.1 then
            local RaycastSucceeded, Result = pcall(function()
                return workspace:Raycast(OriginPosition, Direction, RayParams)
            end)

            if RaycastSucceeded and Result and Result.Instance and Result.Instance.CanCollide then
                return false
            end
        end
    end

    return true
end

StopKillAura = function()
    if KillAuraConnection then
        KillAuraConnection:Disconnect()
        KillAuraConnection = nil
    end
end

local function StartKillAura()
    if KillAuraConnection then
        return
    end

    local NextSwingTime = 0

    KillAuraConnection = RunService.Heartbeat:Connect(function()
        if not CoreIsAlive or not KillAuraEnabled then
            return
        end
        if os.clock() < NextSwingTime then
            return
        end

        local Knife = GetHeldKnife()
        local Handle = Knife and Knife:FindFirstChild("Handle")
        if not Handle then
            return -- not the murderer this round
        end

        local Character = LocalPlayer.Character
        local RootPart = Character and Character:FindFirstChild("HumanoidRootPart")
        if not RootPart then
            return
        end

        local TouchFunction = firetouchinterest or (syn and syn.firetouchinterest)
        if not TouchFunction then
            return
        end

        for _, OtherPlayer in ipairs(PlayersService:GetPlayers()) do
            if OtherPlayer ~= LocalPlayer then
                local OtherCharacter = OtherPlayer.Character
                local OtherRoot = OtherCharacter and OtherCharacter:FindFirstChild("HumanoidRootPart")
                local OtherHumanoid = OtherCharacter and OtherCharacter:FindFirstChildOfClass("Humanoid")

                if OtherRoot and OtherHumanoid and OtherHumanoid.Health > 0 then
                    local Distance = (OtherRoot.Position - RootPart.Position).Magnitude
                    if Distance <= KillAuraRange then
                        local Allowed = true
                        if LegitModeEnabled then
                            Allowed = TargetIsVisible(RootPart.Position, OtherRoot)
                        end

                        if Allowed then
                            pcall(function()
                                TouchFunction(OtherRoot, Handle, 0)
                                TouchFunction(OtherRoot, Handle, 1)
                            end)
                            NextSwingTime = os.clock() + 0.12
                        end
                    end
                end
            end
        end
    end)
end

