local function CollectGameDataRoles()
    local GetPlayerDataRemote = ReplicatedStorageService:FindFirstChild("GetPlayerData", true)
    if not GetPlayerDataRemote or not GetPlayerDataRemote:IsA("RemoteFunction") then
        return false
    end

    local RequestSucceeded, DataTable = pcall(function()
        return GetPlayerDataRemote:InvokeServer()
    end)
    if not RequestSucceeded then
        return false
    end

    return ConsumePlayerData(DataTable, "GET PLAYER DATA")
end

-- ---- source 3: quiet fallback ----
local function EquipmentGuess(TargetPlayer)
    local Backpack = TargetPlayer:FindFirstChildOfClass("Backpack")
    local Character = TargetPlayer.Character

    local function Carries(ToolName)
        if Backpack and Backpack:FindFirstChild(ToolName) then
            return true
        end
        return Character ~= nil and Character:FindFirstChild(ToolName) ~= nil
    end

    if Carries("Knife") then
        return "Murderer"
    end
    if Carries("Gun") or Carries("Revolver") then
        return GunWasDropped and "Hero" or "Sheriff"
    end
    return nil
end

-- HERO TRACKING.
-- the role packet is sent once, at the start of the round, so an innocent
-- who later grabs the dropped gun still reads as "Innocent" forever. the
-- game itself never re-sends anything. so the pickup is tracked separately
-- and layered on top of whatever the packet said:
--   someone holds the gun + they are not the player the round started with
--   as sheriff  ->  Hero.
local function CarriesTool(TargetPlayer, ToolName)
    local Backpack = TargetPlayer:FindFirstChildOfClass("Backpack")
    if Backpack and Backpack:FindFirstChild(ToolName) then
        return true
    end
    local Character = TargetPlayer.Character
    return Character ~= nil and Character:FindFirstChild(ToolName) ~= nil
end

local function HoldsTheGun(TargetPlayer)
    return CarriesTool(TargetPlayer, "Gun") or CarriesTool(TargetPlayer, "Revolver")
end

local function RefreshGunDropState()
    -- must not be sticky: once the drop is gone the flag has to clear again,
    -- a leftover "true" from an earlier round is what mislabelled the sheriff.
    -- uses the same cached locator as the ESP, so it costs nothing.
    GunWasDropped = (LocateDroppedGun ~= nil) and (LocateDroppedGun() ~= nil)
end

-- SHERIFF FIX.
-- the old order tested GunWasDropped before the actual role, so the real
-- sheriff holding their own gun got repainted as Hero. now the game's data
-- always wins: only an Innocent or Unknown can ever be promoted.
local function ApplyHeroOverride(TargetPlayer, BaseRole)
    -- a role the game handed us is final, never argue with it
    if BaseRole == "Murderer" or BaseRole == "Hero" then
        return BaseRole
    end

    if BaseRole == "Sheriff" then
        if RoundSheriffUserId == nil then
            RoundSheriffUserId = TargetPlayer.UserId
        end
        return "Sheriff" -- the sheriff stays the sheriff, gun or no gun
    end

    -- from here on the player is Innocent or Unknown
    if not HoldsTheGun(TargetPlayer) then
        return BaseRole
    end

    -- the round's sheriff can never be demoted by a stale reading
    if RoundSheriffUserId == TargetPlayer.UserId then
        return "Sheriff"
    end

    -- an innocent carrying the gun is the hero
    return "Hero"
end

local function ResolveRoleFor(TargetPlayer)
    local PacketRole = RoleFromPacket[TargetPlayer.UserId]
    if PacketRole then
        return ApplyHeroOverride(TargetPlayer, PacketRole)
    end

    local GuessedRole = EquipmentGuess(TargetPlayer)
    if GuessedRole then
        RoundIsLive = true
        if ActiveRoleSource == "WAITING" then
            ActiveRoleSource = "FALLBACK"
        end
        return ApplyHeroOverride(TargetPlayer, GuessedRole)
    end

    -- joined while the round was already running and nothing was handed out
    if JoinedMidRound[TargetPlayer] then
        return "Unknown"
    end

    if RoundIsLive and TargetPlayer.Character and TargetPlayer.Character:FindFirstChildOfClass("Humanoid") then
        return "Innocent"
    end

    return "Unknown"
end

-- the combat tab asks the role engine who the murderer is
GetRoleOfPlayer = function(TargetPlayer)
    return RoleByPlayer[TargetPlayer]
end

-- MURDERER SERVER HOP.
-- Checked once a round actually has role data. If you are anything other
-- than the Murderer this trip, a short delay lets the notification show
-- before the client disconnects into a fresh server.
local function CheckMurderHop()
    if not MurderHopEnabled or HasHoppedThisRound then
        return
    end

    local MyRoleKey = RoleFromPacket[LocalPlayer.UserId]
    if not MyRoleKey or MyRoleKey == "Murderer" then
        return
    end

    HasHoppedThisRound = true
    if ShowNotification then
        ShowNotification("SERVER HOP", "Not the Murderer this round, hopping servers...", Color3.fromRGB(235, 180, 110))
    end

    task.delay(1.2, function()
        pcall(function()
            TeleportService:Teleport(game.PlaceId, LocalPlayer)
        end)
    end)
end

-- ---- visuals ----
local function DestroyEspFor(TargetPlayer)
    local ExistingHighlight = EspHighlights[TargetPlayer]
    if ExistingHighlight then
        ExistingHighlight:Destroy()
        EspHighlights[TargetPlayer] = nil
    end
    local ExistingTag = EspNameTags[TargetPlayer]
    if ExistingTag then
        ExistingTag:Destroy()
        EspNameTags[TargetPlayer] = nil
    end
end

local function PaintEspFor(TargetPlayer, RoleKey)
    if TargetPlayer == LocalPlayer then
        return
    end

    local Character = TargetPlayer.Character
    if not Character then
        return
    end

    local RoleTheme = RoleThemes[RoleKey] or RoleThemes.Unknown

    -- chams
    if HighlightEnabled then
        local RoleHighlight = EspHighlights[TargetPlayer]
        if not RoleHighlight or RoleHighlight.Parent ~= Character then
            if RoleHighlight then
                RoleHighlight:Destroy()
            end
            RoleHighlight = Instance.new("Highlight")
            RoleHighlight.Name = "BlackAlibiRoleHighlight"
            RoleHighlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            RoleHighlight.FillTransparency = 0.55
            RoleHighlight.OutlineTransparency = 0
            RoleHighlight.Parent = Character
            EspHighlights[TargetPlayer] = RoleHighlight
        end
        RoleHighlight.FillColor = RoleTheme.Color
        RoleHighlight.OutlineColor = RoleTheme.Color
    elseif EspHighlights[TargetPlayer] then
        EspHighlights[TargetPlayer]:Destroy()
        EspHighlights[TargetPlayer] = nil
    end

    -- name + role tag
    if NameTagsEnabled then
        local AnchorPart = Character:FindFirstChild("Head") or Character:FindFirstChild("HumanoidRootPart")
        if AnchorPart then
            local NameTag = EspNameTags[TargetPlayer]
            if not NameTag or NameTag.Adornee ~= AnchorPart then
                if NameTag then
                    NameTag:Destroy()
                end
                NameTag = Instance.new("BillboardGui")
                NameTag.Name = "BlackAlibiRoleTag"
                NameTag.Adornee = AnchorPart
                NameTag.Size = UDim2.fromOffset(230, 40)
                NameTag.StudsOffset = Vector3.new(0, 2.7, 0)
                NameTag.AlwaysOnTop = true
                NameTag.LightInfluence = 0
                NameTag.Parent = AnchorPart

                local TagText = Instance.new("TextLabel")
                TagText.Name = "TagText"
                TagText.Size = UDim2.fromScale(1, 1)
                TagText.BackgroundTransparency = 1
                TagText.Font = Enum.Font.Code
                TagText.TextSize = 14
                TagText.RichText = true
                TagText.TextStrokeTransparency = 0
                TagText.TextStrokeColor3 = Color3.new(0, 0, 0)
                TagText.Parent = NameTag

                EspNameTags[TargetPlayer] = NameTag
            end

            local TagText = NameTag:FindFirstChild("TagText")
            if TagText then
                -- nick and role share the role color, exactly as asked
                TagText.TextColor3 = RoleTheme.Color
                TagText.Text = TargetPlayer.Name .. "\n" .. RoleTheme.Label
            end
        end
    elseif EspNameTags[TargetPlayer] then
        EspNameTags[TargetPlayer]:Destroy()
        EspNameTags[TargetPlayer] = nil
    end
end

-- ---- scan ----
ScanEveryone = function()
    if not CoreIsAlive then
        return
    end

    RefreshGunDropState()

    local AssignedCount = 0
    local TrackedCount = 0

    for _, TargetPlayer in ipairs(PlayersService:GetPlayers()) do
        if TargetPlayer ~= LocalPlayer then
            TrackedCount = TrackedCount + 1

            local NewRole = ResolveRoleFor(TargetPlayer)
            if NewRole ~= "Unknown" then
                AssignedCount = AssignedCount + 1
            end

            RoleByPlayer[TargetPlayer] = NewRole
            PaintEspFor(TargetPlayer, NewRole)
        end
    end

    -- round is over once nobody holds an assigned role any more
    if RoundIsLive and AssignedCount == 0 then
        RoundIsLive = false
        ActiveRoleSource = "WAITING"
        RoundSheriffUserId = nil
        GunWasDropped = false
        HasHoppedThisRound = false
        table.clear(RoleFromPacket)
        table.clear(JoinedMidRound)
    end

    if RoundIsLive then
        CheckMurderHop()
    end

    ScanCounterLabel.Text = "SCAN · " .. TrackedCount .. " TRACKED"
    RoleSourceLabel.Text = "SOURCE : " .. ActiveRoleSource

    if RoundIsLive then
        RoundStateLabel.Text = "ROUND : LIVE · " .. AssignedCount .. " ROLES RECEIVED"
        RoundStateLabel.TextColor3 = Color3.fromRGB(120, 170, 255)
    else
        RoundStateLabel.Text = "ROUND : LOBBY · WAITING FOR ROLES"
        RoundStateLabel.TextColor3 = Palette.TextFaint
    end
end

-- react the instant a tool lands in a backpack or in a hand
local function WatchPlayer(TargetPlayer)
    if WatchedContainers[TargetPlayer] then
        return
    end
    WatchedContainers[TargetPlayer] = true

    if RoundIsLive then
        JoinedMidRound[TargetPlayer] = true
    end

    TargetPlayer.ChildAdded:Connect(function(Child)
        if Child:IsA("Backpack") then
            Child.ChildAdded:Connect(ScanEveryone)
            Child.ChildRemoved:Connect(ScanEveryone)
        end
    end)

    local ExistingBackpack = TargetPlayer:FindFirstChildOfClass("Backpack")
    if ExistingBackpack then
        ExistingBackpack.ChildAdded:Connect(ScanEveryone)
        ExistingBackpack.ChildRemoved:Connect(ScanEveryone)
    end

    TargetPlayer.CharacterAdded:Connect(function(NewCharacter)
        DestroyEspFor(TargetPlayer)
        NewCharacter.ChildAdded:Connect(ScanEveryone)
        NewCharacter.ChildRemoved:Connect(ScanEveryone)
        task.delay(0.35, ScanEveryone)
    end)

    if TargetPlayer.Character then
        TargetPlayer.Character.ChildAdded:Connect(ScanEveryone)
        TargetPlayer.Character.ChildRemoved:Connect(ScanEveryone)
    end
end

for _, ExistingPlayer in ipairs(PlayersService:GetPlayers()) do
    WatchPlayer(ExistingPlayer)
end

PlayersService.PlayerAdded:Connect(function(NewPlayer)
    WatchPlayer(NewPlayer)
    ScanEveryone()
end)

PlayersService.PlayerRemoving:Connect(function(LeavingPlayer)
    DestroyEspFor(LeavingPlayer)
    RoleByPlayer[LeavingPlayer] = nil
    JoinedMidRound[LeavingPlayer] = nil
    WatchedContainers[LeavingPlayer] = nil
end)

workspace.ChildAdded:Connect(function(NewChild)
    if NewChild.Name == "GunDrop" then
        ScanEveryone()
    end
end)

