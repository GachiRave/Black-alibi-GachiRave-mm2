    if not NewState then
        for TargetPlayer, TagInstance in pairs(EspNameTags) do
            TagInstance:Destroy()
            EspNameTags[TargetPlayer] = nil
        end
    end
    ScanEveryone()
end

CleanupRoleEsp = function()
    HighlightEnabled = false
    NameTagsEnabled = false

    for TargetPlayer in pairs(RoleByPlayer) do
