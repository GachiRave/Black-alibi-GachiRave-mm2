-- SERVER HOP.
-- Reads the public server list straight from the Roblox games API and jumps
-- to a random server that is not full and is not the one you are already in.
-- If the list can't be read at all, it falls back to a normal rejoin so the
-- button never just does nothing.
local function AttemptServerHop()
    SetTeleportStatus("SEARCHING FOR A SERVER ...", Color3.fromRGB(150, 190, 255))

    task.spawn(function()
        local ServersUrl = "https://games.roblox.com/v1/games/" .. game.PlaceId ..
            "/servers/Public?sortOrder=Asc&limit=100"

        local RawResponse = nil
        local FetchSucceeded = pcall(function()
            RawResponse = game:HttpGet(ServersUrl)
        end)

        -- some mobile executors only expose the list under a request function
        if not FetchSucceeded or not RawResponse then
            local RequestFunction = http_request or request or (syn and syn.request)
            if RequestFunction then
                local AltSucceeded, AltResponse = pcall(function()
                    return RequestFunction({Url = ServersUrl, Method = "GET"})
                end)
                if AltSucceeded and AltResponse and AltResponse.Body then
                    RawResponse = AltResponse.Body
                    FetchSucceeded = true
                end
            end
        end

        if not FetchSucceeded or not RawResponse then
            SetTeleportStatus("SERVER LIST UNAVAILABLE · REJOINING", Color3.fromRGB(235, 180, 110))
            pcall(function()
                TeleportService:Teleport(game.PlaceId, LocalPlayer)
            end)
            return
        end

        local HttpJson = game:GetService("HttpService")
        local DecodeSucceeded, ServerData = pcall(function()
            return HttpJson:JSONDecode(RawResponse)
        end)

        local CandidateServers = {}
        if DecodeSucceeded and ServerData and ServerData.data then
            for _, ServerEntry in ipairs(ServerData.data) do
                if ServerEntry.id ~= game.JobId
                    and type(ServerEntry.playing) == "number"
                    and type(ServerEntry.maxPlayers) == "number"
                    and ServerEntry.playing < ServerEntry.maxPlayers then
                    table.insert(CandidateServers, ServerEntry)
                end
            end
        end

        if #CandidateServers == 0 then
            SetTeleportStatus("NO OPEN SERVER FOUND · REJOINING", Color3.fromRGB(235, 180, 110))
            pcall(function()
                TeleportService:Teleport(game.PlaceId, LocalPlayer)
            end)
            return
        end

        local ChosenServer = CandidateServers[math.random(1, #CandidateServers)]
        SetTeleportStatus("HOPPING SERVER ...", Color3.fromRGB(120, 210, 140))

        local TeleportSucceeded = pcall(function()
            TeleportService:TeleportToPlaceInstance(game.PlaceId, ChosenServer.id, LocalPlayer)
        end)

        if not TeleportSucceeded then
            SetTeleportStatus("SERVER HOP FAILED", Color3.fromRGB(235, 110, 110))
        end
    end)
end

