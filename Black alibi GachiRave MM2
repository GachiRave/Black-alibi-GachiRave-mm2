local function CreateSquareButton(ParentFrame, Glyph, RightOffset, IsDanger)
    local Button = Instance.new("TextButton")
    Button.Name = "Square_" .. Glyph
    Button.AnchorPoint = Vector2.new(1, 0.5)
    Button.Size = UDim2.fromOffset(26, 26)
    Button.Position = UDim2.new(1, RightOffset, 0.5, 0)
    Button.BackgroundColor3 = Palette.Control
    Button.Text = Glyph
    Button.TextColor3 = Palette.TextDim
    Button.Font = Enum.Font.Code
    Button.TextSize = 16
    Button.AutoButtonColor = false
    Button.ZIndex = 4
    Button.Parent = ParentFrame
    AddCorner(Button, 6)
    AddStroke(Button, Palette.Stroke, 0.45)

    local HoverBackground = IsDanger and Palette.Danger or Color3.fromRGB(37, 37, 43)
    Button.MouseEnter:Connect(function()
        Animate(Button, TweenFast, {BackgroundColor3 = HoverBackground, TextColor3 = Palette.TextMain})
    end)
    Button.MouseLeave:Connect(function()
        Animate(Button, TweenFast, {BackgroundColor3 = Palette.Control, TextColor3 = Palette.TextDim})
    end)

    local PressScale = Instance.new("UIScale")
    PressScale.Parent = Button
    Button.InputBegan:Connect(function(Input)
        if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
            Animate(PressScale, TweenFast, {Scale = 0.9})
        end
    end)
    Button.InputEnded:Connect(function(Input)
        if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
            Animate(PressScale, TweenFast, {Scale = 1})
        end
    end)

    return Button
end

