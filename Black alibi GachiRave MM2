-- ---------- knife throw button ----------
-- FindKnifeThrowTarget and RunKnifeThrow are defined in full before the
-- floating button is built, so the button's click handler never needs a
-- forward declared upvalue: everything it calls already exists.
local function FindKnifeThrowTarget(RootPart)
    local KNIFE_THROW_MAX_RANGE = 65

    local BestSheriffPlayer, BestSheriffRoot, BestSheriffDistance
    local BestAnyPlayer, BestAnyRoot, BestAnyDistance

    for _, OtherPlayer in ipairs(PlayersService:GetPlayers()) do
        if OtherPlayer ~= LocalPlayer then
            local OtherCharacter = OtherPlayer.Character
            local OtherRoot = OtherCharacter and OtherCharacter:FindFirstChild("HumanoidRootPart")
            local OtherHumanoid = OtherCharacter and OtherCharacter:FindFirstChildOfClass("Humanoid")

            if OtherRoot and OtherHumanoid and OtherHumanoid.Health > 0 then
                local Distance = (OtherRoot.Position - RootPart.Position).Magnitude
                if Distance <= KNIFE_THROW_MAX_RANGE and TargetIsVisible(RootPart.Position, OtherRoot) then
                    local RoleKey = GetRoleOfPlayer and GetRoleOfPlayer(OtherPlayer)

                    if RoleKey == "Sheriff" and (not BestSheriffDistance or Distance < BestSheriffDistance) then
                        BestSheriffPlayer, BestSheriffRoot, BestSheriffDistance = OtherPlayer, OtherRoot, Distance
                    end
                    if not BestAnyDistance or Distance < BestAnyDistance then
                        BestAnyPlayer, BestAnyRoot, BestAnyDistance = OtherPlayer, OtherRoot, Distance
                    end
                end
            end
        end
    end

    -- the sheriff always wins the pick when one is out in the open
    if BestSheriffRoot then
        return BestSheriffPlayer, BestSheriffRoot
    end
    return BestAnyPlayer, BestAnyRoot
end

