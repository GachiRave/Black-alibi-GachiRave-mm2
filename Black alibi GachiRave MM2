-- ============ shutdown ============
local function ShutdownCore()
    if not CoreIsAlive then
        return
    end
    CoreIsAlive = false

    -- everything the script switched on goes back off
    HighlightEnabled = false
    NameTagsEnabled = false
    PlayerTweaksEnabled = false
    NoclipEnabled = false
    InfiniteJumpEnabled = false
    GunEspEnabled = false
    AntiFlingEnabled = false
    XRayEnabled = false
    SpinEnabled = false
    KillAuraEnabled = false
    AimbotEnabled = false
    AutoGrabGunEnabled = false
    MurdererRadarEnabled = false
    DangerAlertEnabled = false
    CoinCollectorEnabled = false
    KnifeThrowButtonEnabled = false

    StopNoclip()
    ClearGunEsp()
    DisableXRay()
    ClearAntiFlingConnections()
    StopSpin()
    StopKillAura()
    StopAimbot()
    DisconnectMovementConnections()
    if StopMurdererRadar then StopMurdererRadar() end
    if StopDangerAlertLoop then StopDangerAlertLoop() end
    if StopCoinCollectorLoop then StopCoinCollectorLoop() end
    if HideKnifeThrowFab then HideKnifeThrowFab() end

    -- give the camera back to the game
    if workspace.CurrentCamera then
        workspace.CurrentCamera.FieldOfView = DEFAULT_FIELD_OF_VIEW
    end

    if CleanupRoleEsp then
        CleanupRoleEsp()
    end

    -- hand the character back to the game with stock movement values
    local Humanoid = GetLocalHumanoid()
    if Humanoid then
        Humanoid.WalkSpeed = DEFAULT_WALK_SPEED
        Humanoid.JumpPower = DEFAULT_JUMP_POWER
    end

    TweenService:Create(BackdropBlur, TweenFast, {Size = 0}):Play()
    TweenService:Create(DimLayer, TweenFast, {BackgroundTransparency = 1}):Play()
    TweenService:Create(MainWindow, TweenFast, {GroupTransparency = 1}):Play()
    TweenService:Create(MinimizeBar, TweenFast, {GroupTransparency = 1}):Play()
    TweenService:Create(ConfirmOverlay, TweenFast, {BackgroundTransparency = 1}):Play()
    TweenService:Create(ConfirmDialog, TweenFast, {GroupTransparency = 1}):Play()

    task.delay(0.26, function()
        pcall(function() BackdropBlur:Destroy() end)
        pcall(function() RootGui:Destroy() end)
    end)
end

ConfirmAccept.Activated:Connect(ShutdownCore)

