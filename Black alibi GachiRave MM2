TryAutoGrabGun = function()
    if not CoreIsAlive or not AutoGrabGunEnabled then
        return
    end
    if not RunGrabGun then
        return
    end
    -- a short beat lets the drop settle before we teleport onto it
    task.delay(0.25, function()
        if CoreIsAlive and AutoGrabGunEnabled and LocateDroppedGun and LocateDroppedGun() then
            RunGrabGun()
        end
    end)
end

