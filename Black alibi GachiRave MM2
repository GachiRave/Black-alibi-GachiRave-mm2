-- a builder that failed at startup leaves its setter nil, and a saved config
-- naming that switch used to throw halfway through the load and abandon the
-- rest of the preset. every switch goes through this guard now.
local function ApplyToggleFromConfig(SetterName, DesiredState)
    local SetterFunction = Setters[SetterName]
    if type(SetterFunction) ~= "function" then
        return
    end
    pcall(SetterFunction, DesiredState and true or false)
end

