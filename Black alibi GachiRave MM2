local function ReadConfig(ConfigName)
    if SessionConfigStore[ConfigName] then
        return SessionConfigStore[ConfigName]
    end
    if not FileApiAvailable then
        return nil
    end

    local Path = GetConfigPath(ConfigName)
    local FileCheckSucceeded, ConfigFileExists = pcall(FileExists, Path)
    if not FileCheckSucceeded or not ConfigFileExists then
        return nil
    end

    local Ok, RawText = pcall(FileRead, Path)
    if not Ok or not RawText then
        return nil
    end

    local Decoded, DecodedTable = pcall(function()
        return HttpServiceForJson:JSONDecode(RawText)
    end)
    if Decoded then
        return DecodedTable
    end
    return nil
end

CreatePageButton(PageSettings, "SAVE CONFIG", 118, true, function()
    local ConfigName = string.gsub(ConfigNameBox.Text, "[^%w_%- ]", "")
    ConfigName = string.gsub(ConfigName, "^%s+", "")
    ConfigName = string.gsub(ConfigName, "%s+$", "")

    if ConfigName == "" then
        SetConfigStatus("ENTER A NAME FIRST", Color3.fromRGB(235, 110, 110))
        return
    end

    local Snapshot = CollectConfigSnapshot and CollectConfigSnapshot() or {}
    SessionConfigStore[ConfigName] = Snapshot

    if FileApiAvailable then
        local Encoded, EncodedText = pcall(function()
            return HttpServiceForJson:JSONEncode(Snapshot)
        end)

        -- the old path called a save "written" even when encoding failed
        if not Encoded or type(EncodedText) ~= "string" then
            SetConfigStatus("SAVED FOR THIS SESSION ONLY", Color3.fromRGB(235, 180, 110))
            SelectConfig(ConfigName)
            return
        end

        local Written = pcall(FileWrite, GetConfigPath(ConfigName), EncodedText)
        if not Written then
            SetConfigStatus("SAVED FOR THIS SESSION ONLY", Color3.fromRGB(235, 180, 110))
            SelectConfig(ConfigName)
            return
        end

        -- read it straight back: a silent write failure is worse than none
        local Verified = pcall(FileRead, GetConfigPath(ConfigName))
        if not Verified then
            SetConfigStatus("SAVED FOR THIS SESSION ONLY", Color3.fromRGB(235, 180, 110))
            SelectConfig(ConfigName)
            return
        end
    end

    SelectConfig(ConfigName)
    SetConfigStatus("SAVED : " .. ConfigName, Color3.fromRGB(120, 210, 140))
end)

