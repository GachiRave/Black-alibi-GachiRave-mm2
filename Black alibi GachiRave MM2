local function SwitchTab(TargetButton, TargetPage)
    if TargetButton == ActiveTabButton then
        return
    end

    ActiveTabButton = TargetButton

    for _, Button in ipairs({TabEsp, TabPlayer, TabCombat, TabTeleport, TabExtra, TabAuthor, TabSettings}) do
        local IsActive = (Button == TargetButton)
        Animate(Button, TweenFast, {
            BackgroundTransparency = IsActive and 0 or 1,
            TextColor3 = IsActive and Palette.TextMain or Palette.TextDim
        })
    end

    Animate(TabIndicator, TabIndicatorTween, {
        Position = UDim2.new(0, 0, 0, TargetButton.AbsolutePosition.Y - Sidebar.AbsolutePosition.Y + (TargetButton.AbsoluteSize.Y / 2))
    })

    if ActivePage and ActivePage ~= TargetPage then
        ActivePage.Visible = false
    end
    ActivePage = TargetPage

    TargetPage.Position = PageRestPosition + UDim2.fromOffset(10, 0)
    TargetPage.GroupTransparency = 1
    TargetPage.Visible = true

    Animate(TargetPage, PageSlideIn, {GroupTransparency = 0})
    Animate(TargetPage, PageSlideIn, {Position = PageRestPosition})
end

