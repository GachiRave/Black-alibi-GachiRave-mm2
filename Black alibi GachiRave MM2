-- toggle rows: label on the left, ON/OFF pill on the right
local function CreateToggleRow(ParentPage, RowText, TopOffset, OnStateChanged)
    local Row = Instance.new("TextButton")
    Row.Name = "Toggle_" .. RowText
    Row.Size = UDim2.new(1, -28, 0, 30)
    Row.Position = UDim2.new(0, 14, 0, TopOffset)
    Row.BackgroundColor3 = Color3.fromRGB(27, 27, 32)
    Row.Text = ""
    Row.AutoButtonColor = false
    Row.ZIndex = 4
    Row.Parent = ParentPage
    AddCorner(Row, 7)
    local RowStroke = AddStroke(Row, Palette.Stroke, 0.4)

    local RowScale = Instance.new("UIScale")
    RowScale.Parent = Row

    local RowLabel = Instance.new("TextLabel")
    RowLabel.Size = UDim2.new(1, -80, 1, 0)
    RowLabel.Position = UDim2.new(0, 12, 0, 0)
    RowLabel.BackgroundTransparency = 1
    RowLabel.Text = RowText
    RowLabel.TextColor3 = Color3.fromRGB(196, 196, 206)
    RowLabel.Font = Enum.Font.Code
    RowLabel.TextSize = 12
    RowLabel.TextXAlignment = Enum.TextXAlignment.Left
    RowLabel.ZIndex = 5
    RowLabel.Parent = Row

    local StatePill = Instance.new("TextLabel")
    StatePill.AnchorPoint = Vector2.new(1, 0.5)
    StatePill.Size = UDim2.fromOffset(44, 20)
    StatePill.Position = UDim2.new(1, -10, 0.5, 0)
    StatePill.BackgroundColor3 = Color3.fromRGB(38, 38, 45)
    StatePill.Text = "OFF"
    StatePill.TextColor3 = Palette.TextFaint
    StatePill.Font = Enum.Font.Code
    StatePill.TextSize = 11
    StatePill.ZIndex = 5
    StatePill.Parent = Row
    AddCorner(StatePill, 10)

    local StatePillScale = Instance.new("UIScale")
    StatePillScale.Parent = StatePill

    local IsEnabled = false

    -- visuals always follow the boolean, never the previous text
    local function RenderState()
        Animate(Row, TweenFast, {BackgroundColor3 = IsEnabled and Palette.AccentSoft or Color3.fromRGB(27, 27, 32)})
        Animate(RowStroke, TweenFast, {Color = IsEnabled and Palette.Accent or Palette.Stroke, Transparency = IsEnabled and 0.35 or 0.4})
        Animate(RowLabel, TweenFast, {TextColor3 = IsEnabled and Palette.TextMain or Color3.fromRGB(196, 196, 206)})
        Animate(StatePill, TweenFast, {BackgroundColor3 = IsEnabled and Palette.Accent or Color3.fromRGB(38, 38, 45)})
        StatePill.Text = IsEnabled and "ON" or "OFF"
        StatePill.TextColor3 = IsEnabled and Color3.fromRGB(255, 255, 255) or Palette.TextFaint

        StatePillScale.Scale = 0.7
        Animate(StatePillScale, TweenBounce, {Scale = 1})
    end

    Row.InputBegan:Connect(function(Input)
        if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
            Animate(RowScale, TweenFast, {Scale = 0.97})
        end
    end)
    Row.InputEnded:Connect(function(Input)
        if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
            Animate(RowScale, TweenFast, {Scale = 1})
        end
    end)

    Row.Activated:Connect(function()
        IsEnabled = not IsEnabled
        RenderState()
        OnStateChanged(IsEnabled)
    end)

    -- the config loader replays a saved state through this instead of a fake click
    local function SetState(ShouldBeEnabled)
        ShouldBeEnabled = ShouldBeEnabled and true or false
        if ShouldBeEnabled == IsEnabled then
            return
        end
        IsEnabled = ShouldBeEnabled
        RenderState()
        OnStateChanged(IsEnabled)
    end

    return SetState
end

