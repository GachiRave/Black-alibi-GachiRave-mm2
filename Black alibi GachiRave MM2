-- anti fling: only the upper body phases, mass untouched so walking is normal
local AntiFlingOn = false
local StopAntiFling

do
    local Conn = nil
    local Watchers = {}
    local Saved = {}
    local NextSweep = 0
    local SafeCFrame = nil
    local NextSafe = 0
    local MAX_SPIN = 45
    local MAX_SPEED = 420

    local function PhaseBody(Char, IncludeSelf)
        if not Char then return end
        for _, Limb in ipairs(Char:GetChildren()) do
            if Limb:IsA("BasePart") then
                local Skip = IncludeSelf and (Limb.Name == "HumanoidRootPart"
                    or string.find(string.lower(Limb.Name), "leg")
                    or string.find(string.lower(Limb.Name), "foot"))
                if not Skip and Limb.CanCollide then
                    if Saved[Limb] == nil then Saved[Limb] = Limb.CanCollide end
                    Limb.CanCollide = false
                end
            end
        end
        if IncludeSelf then
            local H = Char:FindFirstChildOfClass("Humanoid")
            if H then
                pcall(function()
                    H:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
                    H:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
                end)
            end
        end
    end

    StopAntiFling = function()
        if Conn then
            Conn:Disconnect()
            Conn = nil
        end
        for _, W in ipairs(Watchers) do W:Disconnect() end
        table.clear(Watchers)
        for Limb, Value in pairs(Saved) do
            if Limb and Limb.Parent then
                pcall(function() Limb.CanCollide = Value end)
            end
        end
        table.clear(Saved)
        SafeCFrame = nil

        local H = LocalHumanoid()
        if H then
            pcall(function()
                H:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, true)
                H:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
            end)
        end
    end

    Setters.AntiFling = ToggleRow(PagePlayer, "АНТИ ФЛИНГ", 220, function(S)
        AntiFlingOn = S
        if not S then
            StopAntiFling()
            return
        end

        PhaseBody(LocalPlayer.Character, true)

        table.insert(Watchers, LocalPlayer.CharacterAdded:Connect(function(Char)
            table.clear(Saved)
            if not AntiFlingOn then return end
            Char:WaitForChild("HumanoidRootPart", 10)
            task.wait(0.3)
            if AntiFlingOn then PhaseBody(Char, true) end
        end))

        Conn = RunService.Stepped:Connect(function()
            if not Alive or not AntiFlingOn then return end

            local Char = LocalPlayer.Character
            local Root = Char and Char:FindFirstChild("HumanoidRootPart")
            local H = Char and Char:FindFirstChildOfClass("Humanoid")
            if not Root or not H or H.Health <= 0 then
                SafeCFrame = nil
                return
            end

            local Torso = Char:FindFirstChild("UpperTorso") or Char:FindFirstChild("Torso")
            if Torso and Torso.CanCollide then
                PhaseBody(Char, true)
            end

            -- other bodies on a slow timer, per frame writes froze the lobby
            if os.clock() >= NextSweep then
                NextSweep = os.clock() + 0.5
                for _, Other in ipairs(PlayersService:GetPlayers()) do
                    if Other ~= LocalPlayer then
                        PhaseBody(Other.Character, false)
                    end
                end
            end

            local Linear = Root.AssemblyLinearVelocity
            local Angular = Root.AssemblyAngularVelocity
            if Angular.Magnitude > MAX_SPIN or Linear.Magnitude > MAX_SPEED then
                Root.AssemblyAngularVelocity = Vector3.zero
                Root.AssemblyLinearVelocity = Vector3.new(0, math.min(Linear.Y, 0), 0)
                H.PlatformStand = false
                if SafeCFrame then
                    pcall(function()
                        Char:PivotTo(SafeCFrame)
                        Root.AssemblyLinearVelocity = Vector3.zero
                        Root.AssemblyAngularVelocity = Vector3.zero
                    end)
                end
                return
            end

            if os.clock() >= NextSafe and H.FloorMaterial ~= Enum.Material.Air then
                NextSafe = os.clock() + 0.35
                SafeCFrame = Root.CFrame
            end
        end)
    end)
end

