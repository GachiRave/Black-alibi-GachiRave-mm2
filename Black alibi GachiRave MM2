local function RunKnifeThrow()
    if os.clock() - LastKnifeThrowTime < 0.35 then
        return
    end
    LastKnifeThrowTime = os.clock()

    local Knife = GetHeldKnife()
    local Handle = Knife and Knife:FindFirstChild("Handle")
    if not Handle then
        ShowNotification("THROW KNIFE", "You need the knife equipped.", Color3.fromRGB(255, 72, 72))
        return
    end

    local Character = LocalPlayer.Character
    local RootPart = Character and Character:FindFirstChild("HumanoidRootPart")
    if not RootPart then
        return
    end

    local BestRoot, BestIsSheriff, BestDistance = nil, false, math.huge

    for _, OtherPlayer in ipairs(PlayersService:GetPlayers()) do
        if OtherPlayer ~= LocalPlayer then
            local OtherCharacter = OtherPlayer.Character
            local OtherRoot = OtherCharacter and OtherCharacter:FindFirstChild("HumanoidRootPart")
            local OtherHumanoid = OtherCharacter and OtherCharacter:FindFirstChildOfClass("Humanoid")

            if OtherRoot and OtherHumanoid and OtherHumanoid.Health > 0 then
                local Distance = (OtherRoot.Position - RootPart.Position).Magnitude
                if Distance <= KillAuraRange and TargetIsVisible(RootPart.Position, OtherRoot) then
                    local IsSheriff = GetRoleOfPlayer and GetRoleOfPlayer(OtherPlayer) == "Sheriff"

                    if IsSheriff and not BestIsSheriff then
                        BestRoot, BestIsSheriff, BestDistance = OtherRoot, true, Distance
                    elseif IsSheriff == BestIsSheriff and Distance < BestDistance then
                        BestRoot, BestDistance = OtherRoot, Distance
                    end
                end
            end
        end
    end

    if not BestRoot then
        ShowNotification("THROW KNIFE", "No visible target in range.", Color3.fromRGB(235, 180, 110))
        return
    end

    local TouchFunction = firetouchinterest or (syn and syn.firetouchinterest)
    if not TouchFunction then
        return
    end

    pcall(function()
        TouchFunction(BestRoot, Handle, 0)
        TouchFunction(BestRoot, Handle, 1)
    end)

    ShowNotification("THROW KNIFE", BestIsSheriff and "Sheriff prioritised and hit." or "Knife thrown, target hit.", Color3.fromRGB(255, 72, 72))
end

