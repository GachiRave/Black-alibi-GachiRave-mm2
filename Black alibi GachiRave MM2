        local Target, Body = FindMurderer()
        if not Target or not Body then
            Notify("SILENT AIM", "Убийца не найден.", Color3.fromRGB(235, 180, 110))
            return
        end

        if AimWallOn then
            local Eye = EyeLevel()
            if Eye and not CanSee(Eye, Body) then
                Notify("SILENT AIM", "Убийца за стеной.", Color3.fromRGB(235, 180, 110))
                return
            end
        end

        NextShot = os.clock() + 0.5
        if FireAt(Gun, Body.Position) then
            Notify("SILENT AIM", "Выстрел в " .. Target.Name, Palette.Blue)
        else
            Notify("SILENT AIM", "Ремоут не отвечает.", Palette.Accent)
