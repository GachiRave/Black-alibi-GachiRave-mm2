-- =====================================================
-- ROLE ENGINE
-- =====================================================
do
    local RoleByPlayer = {}
    local FromPacket = {}
    local Highlights = {}
    local Tags = {}
    local JoinedLate = {}
    local Watched = {}

    local RoundLive = false
    local Source = "ОЖИДАНИЕ"
    local RoundSheriffId = nil
    local GunDropped = false
    local LastShownRole = nil
    local ScanQueued = false
    local LastScan = 0
    local RunScan
    local RefreshRoleCard

    local WordMap = {
        murderer = "Murderer", murder = "Murderer", killer = "Murderer",
        sheriff = "Sheriff", police = "Sheriff",
        hero = "Hero",
        innocent = "Innocent", inno = "Innocent", civilian = "Innocent",
    }

    local function Normalise(Raw)
        if typeof(Raw) ~= "string" then return nil end
        return WordMap[string.lower(Raw)]
    end

    local function ResolveRef(Raw)
        if typeof(Raw) == "Instance" then
            if Raw:IsA("Player") then return Raw end
            if Raw:IsA("Model") then return PlayersService:GetPlayerFromCharacter(Raw) end
        end
        if typeof(Raw) == "string" then return PlayersService:FindFirstChild(Raw) end
        if typeof(Raw) == "number" then return PlayersService:GetPlayerByUserId(Raw) end
        return nil
    end

    -- an entry can be a word, a field or a pile of booleans
    local function RoleFromEntry(Info)
        if typeof(Info) == "string" then return Normalise(Info) end
        if typeof(Info) ~= "table" then return nil end

        local Word = Normalise(Info.Role or Info.role or Info.Team or Info.PlayerRole)
        if Word then return Word end

        if Info.Murderer == true or Info.IsMurderer == true then return "Murderer" end
        if Info.Sheriff == true or Info.IsSheriff == true then return "Sheriff" end
        if Info.Hero == true or Info.IsHero == true then return "Hero" end
        if Info.Innocent == true or Info.IsInnocent == true then return "Innocent" end
        return nil
    end

    local function Commit(Player, Role)
        if not Player or not Role then return end
        FromPacket[Player.UserId] = Role
        RoundLive = true
        Source = "ПАКЕТ РОЛЕЙ"
        JoinedLate[Player] = nil
        if Role == "Sheriff" and RoundSheriffId == nil then
            RoundSheriffId = Player.UserId
        end
        if Player == LocalPlayer and RefreshRoleCard then
            RefreshRoleCard()
        end
    end

    local function Consume(Data, Name)
        if typeof(Data) ~= "table" then return false end
        local Found = false
        for Ref, Info in pairs(Data) do
            local Player = ResolveRef(Ref)
            local Role = RoleFromEntry(Info)
            if Player and Role then
                Commit(Player, Role)
                Found = true
            end
        end
        if Found then Source = Name end
        return Found
    end

    -- one pass per 0.15s: the knife handout fires a burst of container
    -- events and a full sweep on each one is what crashed the client
    local function RequestScan()
        if not Alive or ScanQueued then return end
        local Since = os.clock() - LastScan
        if Since >= 0.15 then
            RunScan()
            return
        end
        ScanQueued = true
        task.delay(0.15 - Since, function()
            ScanQueued = false
            if Alive then RunScan() end
        end)
    end

    local function GetPlayerData()
        local Remote = ReplicatedStorageService:FindFirstChild("GetPlayerData", true)
        if not Remote or not Remote:IsA("RemoteFunction") then return false end
        local Ok, Data = pcall(function() return Remote:InvokeServer() end)
        if not Ok then return false end
        return Consume(Data, "GET PLAYER DATA")
    end

    local Retrying = false

    local function ScheduleRetries()
        if Retrying then return end
        Retrying = true
        task.spawn(function()
            for _ = 1, 8 do
                if not Alive then break end
                if GetPlayerData() then
                    RequestScan()
                    break
                end
                task.wait(1.5)
            end
            Retrying = false
        end)
    end

    local Bound = {}

    local function BindRemote(Remote)
        if Bound[Remote] or not Remote:IsA("RemoteEvent") then return end
        local Name = Remote.Name
        local IsData = Name == "Fade" or Name == "UpdatePlayerData"
        local IsRole = Name == "RoleSelect"
        local IsEnd = Name == "RoundEndFade"
        if not IsData and not IsRole and not IsEnd then return end

        Bound[Remote] = true

        if IsData then
            Remote.OnClientEvent:Connect(function(Data)
                if not Alive then return end
                local Got = Consume(Data, "СОБЫТИЕ ИГРЫ")
                RequestScan()
                if not Got then ScheduleRetries() end
            end)
        elseif IsRole then
            Remote.OnClientEvent:Connect(function(Value)
                if not Alive then return end
                local Role = Normalise(Value)
                if Role then Commit(LocalPlayer, Role) end
                RequestScan()
            end)
        else
            Remote.OnClientEvent:Connect(function()
                if not Alive then return end
                RoundLive = false
                Source = "ОЖИДАНИЕ"
                RoundSheriffId = nil
                GunDropped = false
                LastShownRole = nil
                table.clear(FromPacket)
                table.clear(JoinedLate)
                RequestScan()
            end)
        end
    end

    for _, D in ipairs(ReplicatedStorageService:GetDescendants()) do
        BindRemote(D)
    end
    ReplicatedStorageService.DescendantAdded:Connect(BindRemote)

    local function Carries(Player, Name)
        local Pack = Player:FindFirstChildOfClass("Backpack")
        if Pack and Pack:FindFirstChild(Name) then return true end
        local Char = Player.Character
        return Char ~= nil and Char:FindFirstChild(Name) ~= nil
    end

    local function HoldsGun(Player)
        return Carries(Player, "Gun") or Carries(Player, "Revolver")
    end

    local function Guess(Player)
        if Carries(Player, "Knife") then return "Murderer" end
        if HoldsGun(Player) then
            return GunDropped and "Hero" or "Sheriff"
        end
        return nil
    end

    -- the packet always wins: only Innocent or Unknown can be promoted
    local function HeroOverride(Player, Base)
        if Base == "Murderer" or Base == "Hero" then return Base end
        if Base == "Sheriff" then
            if RoundSheriffId == nil then RoundSheriffId = Player.UserId end
            return "Sheriff"
        end
        if not HoldsGun(Player) then return Base end
        if RoundSheriffId == Player.UserId then return "Sheriff" end
        return "Hero"
    end

    local function Resolve(Player)
        local Packet = FromPacket[Player.UserId]
        if Packet then return HeroOverride(Player, Packet) end

        local Guessed = Guess(Player)
        if Guessed then
            RoundLive = true
            if Source == "ОЖИДАНИЕ" then Source = "СНАРЯЖЕНИЕ" end
            return HeroOverride(Player, Guessed)
        end

        if JoinedLate[Player] then return "Unknown" end
        if RoundLive and Player.Character and Player.Character:FindFirstChildOfClass("Humanoid") then
            return "Innocent"
        end
        return "Unknown"
    end

    GetRole = function(Player)
        return RoleByPlayer[Player]
    end

    local function DropEsp(Player)
        local H = Highlights[Player]
        if H then
            H:Destroy()
            Highlights[Player] = nil
        end
        local T = Tags[Player]
        if T then
            T:Destroy()
            Tags[Player] = nil
        end
    end

    local function PaintEsp(Player, Role)
        if Player == LocalPlayer then return end
        local Char = Player.Character
        if not Char then return end

        local Theme = RoleThemes[Role] or RoleThemes.Unknown

        if HighlightOn then
            local H = Highlights[Player]
            if not H or H.Parent ~= Char then
                if H then H:Destroy() end
                H = Instance.new("Highlight")
                H.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                H.FillTransparency = 0.6
                H.OutlineTransparency = 0
                H.Parent = Char
                Highlights[Player] = H
            end
            H.FillColor = Theme.Color
            H.OutlineColor = Theme.Color
        elseif Highlights[Player] then
            Highlights[Player]:Destroy()
            Highlights[Player] = nil
        end

        if NameTagsOn then
            local Anchor = Char:FindFirstChild("Head") or Char:FindFirstChild("HumanoidRootPart")
            if Anchor then
                local Tag = Tags[Player]
                if not Tag or Tag.Adornee ~= Anchor then
                    if Tag then Tag:Destroy() end
                    Tag = Instance.new("BillboardGui")
                    Tag.Adornee = Anchor
                    Tag.Size = UDim2.fromOffset(220, 38)
                    Tag.StudsOffset = Vector3.new(0, 2.7, 0)
                    Tag.AlwaysOnTop = true
                    Tag.LightInfluence = 0
                    Tag.Parent = Anchor

                    local Text = Instance.new("TextLabel")
                    Text.Name = "Body"
                    Text.Size = UDim2.fromScale(1, 1)
                    Text.BackgroundTransparency = 1
                    Text.Font = Enum.Font.Code
                    Text.TextSize = 13
                    Text.TextStrokeTransparency = 0
                    Text.TextStrokeColor3 = Color3.new(0, 0, 0)
                    Text.Parent = Tag

                    Tags[Player] = Tag
                end

                local Body = Tag:FindFirstChild("Body")
                if Body then
                    Body.TextColor3 = Theme.Color
                    Body.Text = Player.Name .. string.char(10) .. Theme.Label
                end
            end
        elseif Tags[Player] then
            Tags[Player]:Destroy()
            Tags[Player] = nil
        end
    end

    RunScan = function()
        if not Alive then return end
        LastScan = os.clock()

        GunDropped = (LocateGun ~= nil) and (LocateGun() ~= nil)

        local Assigned, Tracked = 0, 0

        for _, Player in ipairs(PlayersService:GetPlayers()) do
            if Player ~= LocalPlayer then
                Tracked = Tracked + 1
                local Role = Resolve(Player)
                if Role ~= "Unknown" then Assigned = Assigned + 1 end
                RoleByPlayer[Player] = Role
                PaintEsp(Player, Role)
            end
        end

        if RoundLive and Assigned == 0 then
            RoundLive = false
            Source = "ОЖИДАНИЕ"
            RoundSheriffId = nil
            GunDropped = false
            LastShownRole = nil
            table.clear(FromPacket)
            table.clear(JoinedLate)
        end

        if RefreshRoleCard then RefreshRoleCard() end

        ScanLabel.Text = "ИСТОЧНИК : " .. Source
        if RoundLive then
            RoundLabel.Text = "РАУНД : ИДЁТ, РОЛЕЙ " .. Assigned
            RoundLabel.TextColor3 = Color3.fromRGB(120, 170, 255)
        else
            RoundLabel.Text = "РАУНД : ЛОББИ"
            RoundLabel.TextColor3 = Palette.TextFaint
        end
    end

    local function Watch(Player)
        if Watched[Player] then return end
        Watched[Player] = true

        if RoundLive then JoinedLate[Player] = true end

        Player.ChildAdded:Connect(function(Child)
            if Child:IsA("Backpack") then
                Child.ChildAdded:Connect(RequestScan)
                Child.ChildRemoved:Connect(RequestScan)
            end
        end)

        local Pack = Player:FindFirstChildOfClass("Backpack")
        if Pack then
            Pack.ChildAdded:Connect(RequestScan)
            Pack.ChildRemoved:Connect(RequestScan)
        end

        Player.CharacterAdded:Connect(function(Char)
            DropEsp(Player)
            Char.ChildAdded:Connect(RequestScan)
            Char.ChildRemoved:Connect(RequestScan)
            task.delay(0.35, RequestScan)
        end)

        if Player.Character then
            Player.Character.ChildAdded:Connect(RequestScan)
            Player.Character.ChildRemoved:Connect(RequestScan)
        end
    end

    for _, Player in ipairs(PlayersService:GetPlayers()) do
        Watch(Player)
    end

    PlayersService.PlayerAdded:Connect(function(Player)
        Watch(Player)
        RequestScan()
    end)

    PlayersService.PlayerRemoving:Connect(function(Player)
        DropEsp(Player)
        RoleByPlayer[Player] = nil
        JoinedLate[Player] = nil
        Watched[Player] = nil
    end)

    workspace.ChildAdded:Connect(function(Child)
        if Child.Name == "GunDrop" then RequestScan() end
    end)

    task.spawn(function()
        while Alive do
            task.wait(4)
            if Alive and RoundLive then RequestScan() end
        end
    end)

    ApplyHighlight = function(State)
        HighlightOn = State
        if not State then
            for Player, H in pairs(Highlights) do
                H:Destroy()
                Highlights[Player] = nil
            end
        end
        RequestScan()
    end

    ApplyNameTags = function(State)
        NameTagsOn = State
        if not State then
            for Player, T in pairs(Tags) do
                T:Destroy()
                Tags[Player] = nil
            end
        end
        RequestScan()
    end

    CleanupEsp = function()
        HighlightOn = false
        NameTagsOn = false
        for Player in pairs(RoleByPlayer) do
            DropEsp(Player)
        end
    end

    -- role card, slides down when the round hands out roles
    local Card = Instance.new("CanvasGroup")
    Card.AnchorPoint = Vector2.new(0.5, 0)
    Card.Position = UDim2.new(0.5, 0, 0, -100)
    Card.Size = UDim2.fromOffset(262, 70)
    Card.BackgroundColor3 = Palette.Window
    Card.BorderSizePixel = 0
    Card.GroupTransparency = 1
    Card.Visible = false
    Card.ZIndex = 45
    Card.Parent = RootGui
    Corner(Card, 11)
    local CardStroke = Stroke(Card, Palette.Stroke, 0.3)

    local CardBar = Instance.new("Frame")
    CardBar.Size = UDim2.fromOffset(3, 42)
    CardBar.Position = UDim2.new(0, 14, 0, 14)
    CardBar.BackgroundColor3 = Palette.TextDim
    CardBar.BorderSizePixel = 0
    CardBar.ZIndex = 46
    CardBar.Parent = Card
    Corner(CardBar, 2)

    local CardCap = Instance.new("TextLabel")
    CardCap.Size = UDim2.new(1, -34, 0, 14)
    CardCap.Position = UDim2.new(0, 26, 0, 14)
    CardCap.BackgroundTransparency = 1
    CardCap.Text = "ТВОЯ РОЛЬ"
    CardCap.TextColor3 = Palette.TextFaint
    CardCap.Font = Enum.Font.Code
    CardCap.TextSize = 10
    CardCap.TextXAlignment = Enum.TextXAlignment.Left
    CardCap.ZIndex = 46
    CardCap.Parent = Card

    local CardValue = Instance.new("TextLabel")
    CardValue.Size = UDim2.new(1, -34, 0, 28)
    CardValue.Position = UDim2.new(0, 26, 0, 30)
    CardValue.BackgroundTransparency = 1
    CardValue.Text = "INNOCENT"
    CardValue.TextColor3 = Palette.TextMain
    CardValue.Font = Enum.Font.Code
    CardValue.TextSize = 22
    CardValue.TextXAlignment = Enum.TextXAlignment.Left
    CardValue.ZIndex = 46
    CardValue.Parent = Card

    local SlideIn = TweenInfo.new(0.5, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
    local CardToken = 0

    local function ShowCard(Role)
        local Theme = RoleThemes[Role] or RoleThemes.Unknown
        CardValue.Text = Theme.Label
        CardValue.TextColor3 = Theme.Color
        CardBar.BackgroundColor3 = Theme.Color
        CardStroke.Color = Theme.Color

        CardToken = CardToken + 1
        local Token = CardToken

        Card.Position = UDim2.new(0.5, 0, 0, -100)
        Card.GroupTransparency = 1
        Card.Visible = true
        Animate(Card, SlideIn, {GroupTransparency = 0, Position = UDim2.new(0.5, 0, 0, 24)})

        task.delay(4, function()
            if not Alive or Token ~= CardToken then return end
            Animate(Card, SlideIn, {GroupTransparency = 1, Position = UDim2.new(0.5, 0, 0, -100)})
            task.delay(0.55, function()
                if Alive and Token == CardToken then Card.Visible = false end
            end)
        end)
    end

    RefreshRoleCard = function()
        if not Alive or not MyRoleOn then return end
        -- only a real assignment, a tool in hand is not a role
        local Role = FromPacket[LocalPlayer.UserId]
        if not Role then return end
        if Role ~= LastShownRole then
            LastShownRole = Role
            ShowCard(Role)
        end
    end

    ApplyRoleCard = function(State)
        if State then
            LastShownRole = nil
            RefreshRoleCard()
            return
        end
        CardToken = CardToken + 1
        Card.Visible = false
        Card.GroupTransparency = 1
        Card.Position = UDim2.new(0.5, 0, 0, -100)
    end

    task.spawn(function()
        while Alive do
            task.wait(0.3)
            if Alive and MyRoleOn then RefreshRoleCard() end
        end
    end)

    StartRoleEngine = function()
        task.spawn(function()
            GetPlayerData()
            RunScan()
        end)
    end
end

-- =====================================================
-- GUN DROP
-- =====================================================
local GunEspOn = false
local ClearGunEsp

do
    local GunColour = Color3.fromRGB(255, 190, 62)
    local Highlight = nil
    local Tag = nil
    local OnGround = false
    local Names = {GunDrop = true, DroppedGun = true}
    local Cached = nil
    local Searched = false
    local Runtime = setmetatable({}, {__mode = "k"})

    local function Anchor(Object)
        if not Object then return nil end
        if Object:IsA("BasePart") then return Object end
        if Object:IsA("Model") then
            return Object.PrimaryPart
                or Object:FindFirstChild("Handle", true)
                or Object:FindFirstChildWhichIsA("BasePart", true)
        end
        return Object:FindFirstChildWhichIsA("BasePart", true)
    end

    local function HasPickup(Object, Part)
        if Part:FindFirstChild("TouchInterest") then return true end
        for _, D in ipairs(Object:GetDescendants()) do
            if D:IsA("TouchTransmitter") or D:IsA("ProximityPrompt")
                or D:IsA("ClickDetector") or D.Name == "TouchInterest" then
                return true
            end
        end
        return false
    end

    local function IsDrop(Object)
        if not Object or not Names[Object.Name] or not Object:IsDescendantOf(workspace) then
            return false
        end

        -- anything owned by a player is not a ground drop
        for _, Other in ipairs(PlayersService:GetPlayers()) do
            local OC = Other.Character
            if OC and Object:IsDescendantOf(OC) then return false end
            local Pack = Other:FindFirstChildOfClass("Backpack")
            if Pack and Object:IsDescendantOf(Pack) then return false end
        end

        if Object:IsA("Tool") and Object.Parent and Object.Parent:FindFirstChildOfClass("Humanoid") then
            return false
        end

        local Part = Anchor(Object)
        if not Part or Part.Transparency >= 1 then return false end

        local Assembly = Part.AssemblyRootPart
        if Assembly and Assembly.Parent and Assembly.Parent:FindFirstChildOfClass("Humanoid") then
            return false
        end

        return HasPickup(Object, Part) or (Runtime[Object] == true and not Part.Anchored)
    end

    local function Valid(Object)
        return Object ~= nil and Object.Parent ~= nil and IsDrop(Object)
    end

    LocateGun = function()
        if Valid(Cached) then return Cached end
        Cached = nil
        if not Searched then
            Searched = true
            for _, D in ipairs(workspace:GetDescendants()) do
                if Names[D.Name] and IsDrop(D) then
                    Cached = D
                    return D
                end
            end
        end
        return nil
    end

    GunAnchor = function()
        return Anchor(LocateGun())
    end

    ClearGunEsp = function()
        if Highlight then
            Highlight:Destroy()
            Highlight = nil
        end
        if Tag then
            Tag:Destroy()
            Tag = nil
        end
    end

    local function Refresh()
        if not Alive or not GunEspOn then
            ClearGunEsp()
            return
        end

        local Object = LocateGun()
        local Part = GunAnchor()
        if not Object or not Part then
            ClearGunEsp()
            return
        end

        if not Highlight or Highlight.Parent ~= Object then
            if Highlight then Highlight:Destroy() end
            Highlight = Instance.new("Highlight")
            Highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            Highlight.FillColor = GunColour
            Highlight.FillTransparency = 0.35
            Highlight.OutlineColor = GunColour
            Highlight.OutlineTransparency = 0
            Highlight.Adornee = Object
            Highlight.Parent = Object
        end

        if not Tag or Tag.Adornee ~= Part then
            if Tag then Tag:Destroy() end
            Tag = Instance.new("BillboardGui")
            Tag.Adornee = Part
            Tag.Size = UDim2.fromOffset(110, 28)
            Tag.StudsOffset = Vector3.new(0, 2, 0)
            Tag.AlwaysOnTop = true
            Tag.LightInfluence = 0
            Tag.Parent = Part

            local Text = Instance.new("TextLabel")
            Text.Size = UDim2.fromScale(1, 1)
            Text.BackgroundTransparency = 1
            Text.Text = "РЕВОЛЬВЕР"
            Text.TextColor3 = GunColour
            Text.Font = Enum.Font.Code
            Text.TextSize = 13
            Text.TextStrokeTransparency = 0
            Text.TextStrokeColor3 = Color3.new(0, 0, 0)
            Text.Parent = Tag
        end
    end

    ApplyGunEsp = function(State)
        GunEspOn = State
        Refresh()
    end

    local function Presence()
        if not Alive then return end
        local Present = LocateGun() ~= nil
        if Present and not OnGround then
            OnGround = true
            Notify("РЕВОЛЬВЕР", "Оружие шерифа выпало.", GunColour)
            if AutoGrabOn and TryAutoGrab then TryAutoGrab() end
        elseif not Present and OnGround then
            OnGround = false
        end
        Refresh()
    end

    workspace.DescendantAdded:Connect(function(D)
        local Candidate = Names[D.Name] and D or nil
        if not Candidate then
            local Current = D.Parent
            while Current and Current ~= workspace do
                if Names[Current.Name] then
                    Candidate = Current
                    break
                end
                Current = Current.Parent
            end
        end
        if Candidate then
            Runtime[Candidate] = true
            task.defer(function()
                if IsDrop(Candidate) then
                    Cached = Candidate
                    Presence()
                end
            end)
        end
    end)

    workspace.DescendantRemoving:Connect(function(D)
        if Cached == D or (Cached and D:IsDescendantOf(Cached)) then
            Cached = nil
            task.defer(Presence)
        end
    end)

    -- grab: one controlled move out, one back, feet on the floor not the gun
    local Grabbing = false

    RunGrabGun = function()
        if Grabbing then return end

        local Char = LocalPlayer.Character
        local Root = Char and Char:FindFirstChild("HumanoidRootPart")
        if not Root then
            TeleStatus("НЕТ ПЕРСОНАЖА", Palette.Accent)
            return
        end

        local Part = GunAnchor()
        if not Part then
            TeleStatus("РЕВОЛЬВЕРА НЕТ НА ЗЕМЛЕ", Palette.Accent)
            return
        end

        Grabbing = true
        TeleStatus("ПОДБИРАЕМ...", Palette.Blue)

        task.spawn(function()
            local H = Char:FindFirstChildOfClass("Humanoid")
            local Home = Char:GetPivot()
            local AutoRotate = H and H.AutoRotate
            local Touch = firetouchinterest or (syn and syn.firetouchinterest)

            local function Freeze()
                if Root and Root.Parent then
                    Root.AssemblyLinearVelocity = Vector3.zero
                    Root.AssemblyAngularVelocity = Vector3.zero
                end
            end

            local Ok, Err = pcall(function()
                if H then H.AutoRotate = false end
                Freeze()

                local Height = H and math.max(2.5, H.HipHeight + (Root.Size.Y * 0.5) + 0.35) or 3

                -- land on the floor under the drop, not inside the model
                local Params = RaycastParams.new()
                pcall(function() Params.FilterType = Enum.RaycastFilterType.Exclude end)
                Params.FilterDescendantsInstances = {Char}
                Params.IgnoreWater = true

                local Floor
                pcall(function()
                    Floor = workspace:Raycast(Part.Position + Vector3.new(0, 4, 0), Vector3.new(0, -40, 0), Params)
                end)

                local Stand = Floor and (Floor.Position + Vector3.new(0, Height, 0))
                    or (Part.Position + Vector3.new(0, Height, 0))

                Char:PivotTo(CFrame.new(Stand))
                Freeze()
                task.wait(0.12)

                if Touch then
                    Touch(Root, Part, 0)
                    task.wait()
                    Touch(Root, Part, 1)
                end
                task.wait(0.18)
            end)

            if Char.Parent and Root.Parent == Char then
                Freeze()
                Char:PivotTo(Home)
                Freeze()
            end
            if H and H.Parent then H.AutoRotate = AutoRotate end

            Grabbing = false

            if not Ok then
                TeleStatus("ОШИБКА ПОДБОРА", Palette.Accent)
                warn("[Black Alibi] grab: " .. tostring(Err))
            elseif Valid(Cached) then
                TeleStatus("ВЕРНУЛИСЬ, РЕВОЛЬВЕР НА МЕСТЕ", Color3.fromRGB(235, 180, 110))
            else
                TeleStatus("РЕВОЛЬВЕР ПОДОБРАН", Palette.Good)
                Notify("РЕВОЛЬВЕР", "Подобран, вернулись на место.", GunColour)
            end
        end)
    end
end

TryAutoGrab = function()
    if not Alive or not AutoGrabOn or not RunGrabGun then return end
    task.delay(0.25, function()
        if Alive and AutoGrabOn and LocateGun and LocateGun() then
            RunGrabGun()
        end
    end)
end

