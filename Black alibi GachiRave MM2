-- MM2 renames the blade per skin, so anything with a handle counts
local function IsKnife(Item)
    if not Item or not Item:IsA("Tool") or not Item:FindFirstChild("Handle") then
        return false
    end
    local Low = string.lower(Item.Name)
    return Low ~= "gun" and Low ~= "revolver"
end

local function PickKnife(Container)
    if not Container then return nil end
    local Exact = Container:FindFirstChild("Knife")
    if Exact and IsKnife(Exact) then return Exact end
    for _, Item in ipairs(Container:GetChildren()) do
        if IsKnife(Item) then return Item end
    end
    return nil
end

local function HeldKnife()
    return PickKnife(LocalPlayer.Character)
end

-- reparent beats EquipTool, some mobile executors drop the humanoid call
local function EquipKnife()
    local Held = HeldKnife()
    if Held then return Held end

    local Char = LocalPlayer.Character
    local Packed = PickKnife(LocalPlayer:FindFirstChildOfClass("Backpack"))
    if not Packed or not Char then return nil end

    pcall(function() Packed.Parent = Char end)
    for _ = 1, 10 do
        local Now = HeldKnife()
        if Now then return Now end
        RunService.Heartbeat:Wait()
    end
    return Packed
end

local function HeldGun()
    local Char = LocalPlayer.Character
    if not Char then return nil end
    return Char:FindFirstChild("Gun") or Char:FindFirstChild("Revolver")
end

local function PackedGun()
    local Pack = LocalPlayer:FindFirstChildOfClass("Backpack")
    if not Pack then return nil end
    return Pack:FindFirstChild("Gun") or Pack:FindFirstChild("Revolver")
end

local function EquipGun()
    local Held = HeldGun()
    if Held then return Held end
    local Char = LocalPlayer.Character
    local Packed = PackedGun()
    if not Packed or not Char then return nil end
    pcall(function() Packed.Parent = Char end)
    for _ = 1, 10 do
        local Now = HeldGun()
        if Now then return Now end
        RunService.Heartbeat:Wait()
    end
    return Packed
end

-- the swing has to land before the touch, the server drops a bare contact
local function KnifeHit(Knife, TargetPart)
    local Handle = Knife and Knife:FindFirstChild("Handle")
    if not Handle or not TargetPart then return false end

    pcall(function() Knife:Activate() end)

    local Touch = firetouchinterest or (syn and syn.firetouchinterest)
    if not Touch then return false end

    pcall(function() Touch(TargetPart, Handle, 0) end)
    RunService.Heartbeat:Wait()
    pcall(function() Touch(TargetPart, Handle, 1) end)
    return true
end

