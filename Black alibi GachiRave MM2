-- three samples down the body, a single centre ray slips past thin walls
local function CanSee(Origin, Target)
    local Params = RaycastParams.new()
    local Ok = pcall(function()
        Params.FilterType = Enum.RaycastFilterType.Exclude
    end)
    if not Ok then
        pcall(function() Params.FilterType = Enum.RaycastFilterType.Blacklist end)
    end

    local Ignore = {}
    if LocalPlayer.Character then table.insert(Ignore, LocalPlayer.Character) end
    if Target.Parent then table.insert(Ignore, Target.Parent) end
    Params.FilterDescendantsInstances = Ignore
    Params.IgnoreWater = true

    for _, Offset in ipairs({Vector3.new(0, 1.4, 0), Vector3.zero, Vector3.new(0, -1.4, 0)}) do
        local Point = Target.Position + Offset
        local Dir = Point - Origin
        if Dir.Magnitude >= 0.1 then
            local Hit
            local RayOk = pcall(function()
                Hit = workspace:Raycast(Origin, Dir, Params)
            end)
            if RayOk and Hit and Hit.Instance and Hit.Instance.CanCollide then
                return false
            end
        end
    end
    return true
end

local function EyeLevel()
    local Char = LocalPlayer.Character
    local Root = Char and Char:FindFirstChild("HumanoidRootPart")
    if not Root then return nil end
    return Root.Position + Vector3.new(0, 1.5, 0)
