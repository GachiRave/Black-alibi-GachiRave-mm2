local ActiveTab = TabEsp
local ActivePage = PageEsp
Shells[PageEsp].Visible = true
Shells[PageEsp].GroupTransparency = 0

local function Switch(Button, Page)
    if Button == ActiveTab then return end
    ActiveTab = Button

    for _, B in ipairs({TabEsp, TabPlayer, TabCombat, TabTele, TabExtra, TabAuthor, TabSet}) do
        local On = (B == Button)
        Animate(B, TweenFast, {
            BackgroundTransparency = On and 0 or 1,
            TextColor3 = On and Palette.TextMain or Palette.TextDim,
        })
    end

    Animate(Marker, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Position = UDim2.new(0, 0, 0,
            Button.AbsolutePosition.Y - Sidebar.AbsolutePosition.Y + (Button.AbsoluteSize.Y / 2))
    })

    if ActivePage and ActivePage ~= Page then
        Shells[ActivePage].Visible = false
    end
    ActivePage = Page

    local Shell = Shells[Page]
    Page.CanvasPosition = Vector2.zero
    Shell.Position = PAnchor + UDim2.fromOffset(8, 0)
    Shell.GroupTransparency = 1
    Shell.Visible = true
    Animate(Shell, TweenInfo.new(0.24, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
        GroupTransparency = 0, Position = PAnchor
    })
end

